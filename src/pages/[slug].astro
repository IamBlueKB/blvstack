---
// JANET Published proposals (Feature 3) — the live client-facing page at
// blvstack.com/[slug]. Renders through the shared ProposalRender template (the SAME
// one the admin preview uses, so a preview matches exactly). noindex by default.
// Every view reports back.
//
// Astro serves static routes before this catch-all, so it never shadows an existing
// page; getPublishedBySlug also refuses reserved slugs. Unknown/unpublished → 404.
import { randomUUID } from 'node:crypto';
import { getPublishedBySlug } from '../lib/janet/publish';
import { supabaseAdmin } from '../lib/supabase';
import { docHasFields } from '../lib/janet/doc-blocks';
import { buildSections } from '../lib/janet/doc-render';
import { beaconToken } from '../lib/janet/beacon';
import ProposalRender from '../components/janet/ProposalRender.astro';

export const prerender = false;
const { slug } = Astro.params;

const found = await getPublishedBySlug(slug ?? '');
if (!found) return Astro.rewrite('/404');
const { page, doc } = found;

// 5.2 — mint the view session + a SIGNED beacon token here (SSR), so the view-ingest
// endpoint can reject blind/forged writes that never loaded this page.
let viewSid = Astro.cookies.get('blv_sid')?.value;
if (!viewSid) {
  viewSid = randomUUID();
  Astro.cookies.set('blv_sid', viewSid, { path: '/', httpOnly: true, sameSite: 'lax', secure: true, maxAge: 60 * 60 * 24 * 365 });
}
const viewBeaconToken = beaconToken(page.id, viewSid);

let clientName: string | null = null;
if (doc.client_id) {
  const { data } = await supabaseAdmin.from('janet_clients').select('name').eq('id', doc.client_id).maybeSingle();
  clientName = data?.name ?? null;
}

const sections = buildSections(doc.content);
const dateStr = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const eyebrow = (doc.doc_type || 'proposal').toUpperCase();
const isForm = docHasFields(doc.content);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<ProposalRender
  mode="live"
  title={doc.title}
  eyebrow={eyebrow}
  clientName={clientName}
  dateStr={dateStr}
  sections={sections}
  isForm={isForm}
  indexable={page.indexable}
  pageId={page.id}
  viewBeaconToken={viewBeaconToken}
  turnstileSiteKey={turnstileSiteKey}
  slug={slug}
/>
