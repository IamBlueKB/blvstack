---
// BLV Books — the client-facing signup for a card-subscription retainer (public, by token).
// Same monochrome language as the invoice page. The client adds a card once on Stripe
// Checkout; Stripe charges it every month. Everything shown comes from the retainer.
import { getSignupView } from '../../lib/janet/clearear/subscriptions';

export const prerender = false;
const { token } = Astro.params;

const view = await getSignupView(token ?? '');
if (!view) return new Response('This link isn’t valid.', { status: 404 });

const { retainer, contact, settings, first } = view;
const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
const longDate = (d: string) => new Date(d.length === 10 ? `${d}T12:00:00` : d).toLocaleDateString('en-US', { timeZone: 'America/Chicago', month: 'long', day: 'numeric', year: 'numeric' });
const isBlv = retainer.business === 'blvstack';
const businessName = settings?.business_name || (isBlv ? 'BLVSTACK' : 'Clear Ear Studios');
const appIcon = isBlv ? '/apple-touch-icon.png' : '/clearear-appicon-180.png';
const processing = Astro.url.searchParams.get('stripe') === 'processing';
const state = retainer.status; // pending | active | paused | ended
const firstLabel = first.kind === 'now' ? 'Today, when you add your card' : longDate(first.date);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Monthly plan — {businessName}</title>
    <link rel="apple-touch-icon" href={appIcon} />
    <link rel="icon" type="image/png" href={isBlv ? '/apple-touch-icon.png' : '/clearear-favicon-32.png'} />
    <meta name="apple-mobile-web-app-title" content={businessName} />
    <meta name="theme-color" content="#ffffff" />
    <style>
      :root { --ink:#161616; --body:#2e2e2e; --mute:#8a8a8a; --hair:#e2e2e2; --faint:#f5f5f5; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { background: #ececec; }
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: var(--body); line-height: 1.5; -webkit-font-smoothing: antialiased; padding: 32px 16px 64px; }
      .sheet { max-width: 560px; margin: 0 auto; background: #fff; padding: 48px 48px 40px; box-shadow: 0 1px 3px rgba(0,0,0,.08), 0 8px 40px rgba(0,0,0,.06); }
      .logo { height: 52px; width: auto; display: block; }
      .logo.blv { height: 80px; }
      .kicker { margin-top: 30px; font: 700 8px/1 sans-serif; letter-spacing: .18em; color: var(--mute); }
      h1 { margin-top: 10px; font: 600 22px/1.25 -apple-system, sans-serif; color: var(--ink); letter-spacing: -.01em; }
      .for { margin-top: 4px; font-size: 13.5px; color: var(--mute); }
      .amount { margin-top: 26px; display: flex; align-items: baseline; gap: 8px; }
      .amount .n { font: 700 40px/1 -apple-system, sans-serif; color: var(--ink); letter-spacing: -.02em; }
      .amount .per { font-size: 14px; color: var(--mute); }
      .rows { margin-top: 26px; border-top: 1px solid var(--hair); }
      .row { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--faint); font-size: 13.5px; }
      .row .k { color: var(--mute); }
      .row .v { color: var(--ink); text-align: right; }
      .go { margin-top: 28px; width: 100%; font: 600 12px/1 -apple-system, sans-serif; letter-spacing: .12em; text-transform: uppercase; color: #fff; background: #161616; border: 1px solid #161616; padding: 16px 18px; border-radius: 2px; cursor: pointer; }
      .go:hover { background: #000; }
      .go:disabled { opacity: .55; cursor: default; }
      .note { margin-top: 12px; font-size: 12px; color: var(--mute); text-align: center; }
      .note.err { color: #b91c1c; }
      .done { margin-top: 28px; padding: 14px 16px; background: var(--faint); font-size: 13.5px; color: var(--ink); }
      .done.ok { background: #effaf3; color: #0a5c2e; }
      .fine { margin-top: 18px; font-size: 11.5px; color: var(--mute); line-height: 1.55; }
      .foot { max-width: 560px; margin: 20px auto 0; text-align: center; font-size: 11px; color: var(--mute); }
      @media (max-width: 520px) { body { padding: 16px 12px 48px; } .sheet { padding: 32px 22px 28px; } .amount .n { font-size: 34px; } }
    </style>
  </head>
  <body>
    <div class="sheet">
      {isBlv ? <img src="/blvstack-invoice-logo.png" alt={businessName} class="logo blv" /> : <img src="/clearear-logo.png" alt={businessName} class="logo" />}
      <div class="kicker">AUTOMATIC MONTHLY PAYMENTS</div>
      <h1>{businessName} monthly plan</h1>
      {contact?.name && <div class="for">For {contact.name}</div>}
      <div class="amount"><span class="n">{usd(retainer.monthly_rate)}</span><span class="per">/ month</span></div>

      {state === 'pending' && !processing && (
        <>
          <div class="rows">
            <div class="row"><span class="k">First charge</span><span class="v">{firstLabel}</span></div>
            <div class="row"><span class="k">Then</span><span class="v">Automatically, every month</span></div>
            <div class="row"><span class="k">Payment</span><span class="v">Card · processed securely by Stripe</span></div>
          </div>
          <button class="go" id="go" data-token={token}>Set up automatic payments</button>
          <p class="note" id="msg" style="display:none"></p>
          <p class="fine">You’ll add your card on Stripe’s secure checkout page — {businessName} never sees your card number.</p>
        </>
      )}
      {state === 'pending' && processing && (
        <div class="done ok">Thank you — you’re all set. Your card is on file and will be charged automatically each month.</div>
      )}
      {state === 'active' && (
        <div class="done ok">
          Automatic payments are on.{retainer.current_period_end && <> Next charge: {longDate(retainer.current_period_end)}.</>}
        </div>
      )}
      {state === 'paused' && <div class="done">Automatic payments for this plan are paused.</div>}
      {state === 'ended' && <div class="done">This plan has ended.</div>}
    </div>
    <div class="foot">{[businessName, settings?.email, settings?.phone].filter(Boolean).join('   ·   ')}</div>

    <script is:inline>
      (function(){
        var btn = document.getElementById('go');
        if (!btn) return;
        btn.addEventListener('click', async function(){
          var msg = document.getElementById('msg');
          var token = btn.getAttribute('data-token');
          msg.style.display = 'block'; msg.className = 'note'; msg.textContent = 'Opening secure checkout…';
          btn.disabled = true;
          try {
            var r = await fetch('/api/subscribe/' + token + '/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            var j = await r.json();
            if (r.ok && j.url) { window.location.href = j.url; return; }
            msg.className = 'note err'; msg.textContent = j.error || 'Could not start checkout.';
            btn.disabled = false;
          } catch(e) { msg.className = 'note err'; msg.textContent = 'Network error — please try again.'; btn.disabled = false; }
        });
      })();
    </script>
  </body>
</html>
