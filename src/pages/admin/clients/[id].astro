---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { listPublishedForClient, listClientFormResponses } from '../../../lib/janet/publish';
import { listLogins } from '../../../lib/client-logins';
import { planStatusForClients, TONE_CLASS } from '../../../lib/janet/clearear/plan-status';
import { listBillingEvents, EVENT_LABEL } from '../../../lib/janet/clearear/billing-events';

export const prerender = false;
const adminEmail = Astro.locals.adminEmail;
const { id } = Astro.params;

const { data: client } = await supabaseAdmin.from('janet_clients').select('*').eq('id', id).maybeSingle();
if (!client) return Astro.redirect('/admin/clients');

const [{ data: sites }, { data: deals }] = await Promise.all([
  supabaseAdmin.from('janet_sites').select('id, name, production_url, status, retainer_status').eq('client_id', id).order('name'),
  supabaseAdmin.from('janet_deals').select('id, name, stage, value_estimate, next_action, next_action_due').eq('client_id', id).order('updated_at', { ascending: false }),
]);

const dealIds = (deals ?? []).map((d) => d.id);
let notes: any[] = [];
if (dealIds.length) {
  const { data } = await supabaseAdmin
    .from('janet_notepad_sessions')
    .select('id, title, status, created_at, deal_id')
    .in('deal_id', dealIds)
    .order('created_at', { ascending: false });
  notes = data ?? [];
}

// Feature 1 — threads attached to this client.
const { data: threads } = await supabaseAdmin
  .from('janet_threads')
  .select('id, title, status, last_message_at')
  .eq('client_id', id)
  .eq('status', 'active')
  .order('last_message_at', { ascending: false, nullsFirst: false });

// Feature 2 — docs attached to this client.
const { data: docs } = await supabaseAdmin
  .from('janet_docs')
  .select('id, title, doc_type, updated_at')
  .eq('client_id', id)
  .eq('status', 'active')
  .order('updated_at', { ascending: false });

// Feature 3 — published proposals for this client (with view counts).
const publishedPages = await listPublishedForClient(id!);

// Fillable-form responses submitted by this client.
const formResponses = await listClientFormResponses(id!);

// Billing — the card/invoice plan(s) paying for this client's sites, and what's happened on them.
const plans = (await planStatusForClients([id!])).get(id!) ?? [];
const activity = await listBillingEvents(plans.map((p) => p.retainer_id), 12);
const activityTone: Record<string, string> = { charge_failed: 'text-red-400', site_paused: 'text-amber-400', plan_ended: 'text-slate/50', signed_up: 'text-emerald-400', charge_paid: 'text-emerald-400/80', site_restored: 'text-emerald-400' };
const when = (iso: string) => new Date(iso).toLocaleDateString('en-US', { timeZone: 'America/Chicago', month: 'short', day: 'numeric', year: 'numeric' });

// Logins vault — the accounts behind this client's site(s). Listed WITHOUT secrets; Reveal/Copy fetch one field.
const logins = await listLogins(id!);
const loginData = (l: any) => JSON.stringify({ id: l.id, service: l.service, site_id: l.site_id, login_url: l.login_url, username: l.username, notes: l.notes, has_password: l.has_password, has_api_key: l.has_api_key, has_secret_notes: l.has_secret_notes });
const SERVICES = ['Resend', 'Gmail', 'Google Workspace', 'GoDaddy', 'Namecheap', 'Cloudflare', 'Vercel', 'Supabase', 'Stripe', 'GitHub', 'Instagram', 'Facebook', 'YouTube', 'SoundCloud', 'Spotify for Artists', 'Apple Music for Artists', 'DistroKid', 'Bandcamp', 'TikTok', 'Linktree'];

const STATUSES = ['prospect', 'active', 'past'];
const statusColor = (s: string) =>
  s === 'active' ? 'text-emerald-400 border-emerald-400/30' : s === 'past' ? 'text-slate/50 border-white/10' : 'text-amber-400 border-amber-400/30';
const stageColor = (s: string) =>
  s === 'won' || s === 'delivered' ? 'text-emerald-400' : s === 'lost' ? 'text-slate/50' : s === 'building' ? 'text-electric' : 'text-amber-400';
const fmt = (iso?: string) => (iso ? new Date(iso).toLocaleDateString() : '');
---

<AdminLayout title={client.name} adminEmail={adminEmail} active="janet-clients" janet={{ entity_type: 'client', entity_id: client.id, client_id: client.id, client_name: client.name }}>
  <a href="/admin/clients" class="font-mono text-[10px] tracking-widest uppercase text-slate hover:text-electric transition-colors">← Clients</a>

  <div class="flex items-start justify-between gap-3 mt-3 mb-6">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-bold text-cream tracking-tight">{client.name}</h1>
        <span class={`font-mono text-[8px] tracking-widest uppercase px-1.5 py-0.5 border rounded ${statusColor(client.status)}`}>{client.status}</span>
        {plans.map((p) => <span class={`font-mono text-[8px] tracking-widest uppercase px-1.5 py-0.5 border rounded ${TONE_CLASS[p.tone]}`} title={p.line}>{p.badge}</span>)}
      </div>
      <p class="font-mono text-[11px] text-slate/60 mt-1">
        {client.contact_name ?? 'no contact'}{client.contact_email ? ` · ${client.contact_email}` : ''}{client.contact_phone ? ` · ${client.contact_phone}` : ''}
      </p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <button id="edit-client" class="font-mono text-[10px] tracking-widest uppercase text-slate hover:text-electric px-3 py-2 border border-white/10 transition-colors">Edit</button>
      <button id="del-client" class="font-mono text-[10px] tracking-widest uppercase text-slate hover:text-red-400 px-3 py-2 border border-white/10 transition-colors">Delete</button>
    </div>
  </div>

  <div class="grid lg:grid-cols-[1fr_320px] gap-4">
    <div class="flex flex-col gap-4">
      <!-- Billing: plan status + activity (signups, payments, declines, pauses) -->
      {plans.length > 0 && (
        <div class="border border-white/5 bg-navy p-5">
          <div class="flex items-center justify-between mb-3">
            <p class="font-mono text-[10px] tracking-widest uppercase text-electric">// Billing</p>
            <a href="/admin/clearear/retainers?business=blvstack" class="font-mono text-[9px] tracking-widest uppercase text-slate hover:text-electric">Retainers →</a>
          </div>
          <div class="flex flex-col gap-2 mb-4">
            {plans.map((p) => (
              <div class="flex items-start gap-2">
                <span class={`font-mono text-[8px] tracking-widest uppercase px-1.5 py-0.5 border rounded shrink-0 mt-0.5 ${TONE_CLASS[p.tone]}`}>{p.badge}</span>
                <div class="min-w-0">
                  <p class="text-cream/90 text-[13px]">{p.line}</p>
                  {p.signup_url && <a href={p.signup_url} target="_blank" rel="noopener" class="font-mono text-[11px] text-sky-300/90 hover:text-sky-200 break-all select-all">{p.signup_url}</a>}
                </div>
              </div>
            ))}
          </div>
          <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 mb-2">Activity</p>
          {activity.length === 0 ? <p class="text-slate/50 text-[13px]">Nothing yet — signups, payments, declines and pauses show here.</p> : (
            <div class="flex flex-col gap-1.5">
              {activity.map((e) => (
                <div class="grid grid-cols-[92px_1fr_auto] gap-3 items-baseline text-[12.5px]">
                  <span class="font-mono text-[10px] text-slate/50">{when(e.at)}</span>
                  <span class="min-w-0"><span class={activityTone[e.kind] ?? 'text-cream/85'}>{EVENT_LABEL[e.kind]}</span>{e.detail && <span class="text-slate/60"> — {e.detail}</span>}</span>
                  <span class="font-mono text-[11px] text-cream/70">{e.amount != null && ['charge_paid', 'charge_failed', 'signed_up'].includes(e.kind) ? `$${Number(e.amount).toFixed(2)}` : ''}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      <!-- Sites -->
      <div class="border border-white/5 bg-navy p-5">
        <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-3">// Sites ({(sites ?? []).length})</p>
        {(sites ?? []).length === 0 && <p class="text-slate/50 text-[13px]">No sites yet. Assign one from its <a href="/admin/sites" class="text-electric hover:underline">site page</a>.</p>}
        <div class="flex flex-col gap-2">
          {(sites ?? []).map((s) => (
            <div class="flex items-center justify-between gap-3 border-b border-white/5 pb-2">
              <a href={`/admin/sites/${s.id}`} class="text-cream/90 text-[13px] hover:text-electric transition-colors truncate">{s.name}</a>
              <span class="font-mono text-[9px] uppercase tracking-widest text-slate/50 shrink-0">{s.status}{s.retainer_status !== 'none' ? ` · retainer ${s.retainer_status}` : ''}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Logins vault (encrypted; founder-only; JANET can't read it) -->
      <div class="border border-white/5 bg-navy p-5" id="logins" data-client={client.id}>
        <div class="flex items-center justify-between mb-1">
          <p class="font-mono text-[10px] tracking-widest uppercase text-electric">// Logins ({logins.length})</p>
          <button id="login-add" class="font-mono text-[9px] tracking-widest uppercase text-slate hover:text-electric px-2 py-1 border border-white/10 transition-colors">+ Add login</button>
        </div>
        <p class="font-mono text-[10px] text-slate/40 mb-3">Encrypted · only your admin login can open them — JANET can’t read them · every reveal is logged</p>
        {logins.length === 0 && <p class="text-slate/50 text-[13px]">No logins yet. Add the accounts behind {client.name}’s site — Resend, Gmail, the domain registrar, hosting…</p>}
        <div class="flex flex-col divide-y divide-white/5">
          {logins.map((l) => (
            <div class="py-3" data-login={loginData(l)}>
              <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex items-center gap-2 flex-wrap">
                  <span class="text-cream text-[14px] font-medium">{l.service}</span>
                  {l.site_name && <span class="font-mono text-[9px] uppercase tracking-widest text-slate/50">{l.site_name}</span>}
                  {l.login_url && <a href={l.login_url} target="_blank" rel="noopener" class="font-mono text-[10px] text-electric hover:underline">open login page ↗</a>}
                </div>
                <div class="flex gap-1.5 shrink-0">
                  <button class="l-edit font-mono text-[9px] uppercase tracking-widest px-2 py-1 border border-white/10 text-slate hover:text-electric">Edit</button>
                  <button class="l-del font-mono text-[9px] uppercase tracking-widest px-2 py-1 border border-white/10 text-slate hover:text-red-400">Delete</button>
                </div>
              </div>
              <div class="grid grid-cols-[96px_1fr] gap-x-3 gap-y-1.5 mt-2 text-[12.5px] items-center">
                {l.username && (
                  <>
                    <span class="text-slate/50">Username</span>
                    <span class="flex items-center gap-2 min-w-0"><span class="text-cream/85 font-mono truncate select-all">{l.username}</span><button class="l-copy-plain font-mono text-[9px] uppercase text-slate hover:text-electric" data-v={l.username}>Copy</button></span>
                  </>
                )}
                {[['password', 'Password', l.has_password], ['api_key', 'API key', l.has_api_key], ['secret_notes', 'Recovery / 2FA', l.has_secret_notes]].filter(([, , has]) => has).map(([field, label]) => (
                  <>
                    <span class="text-slate/50">{label}</span>
                    <span class="flex items-start gap-2 min-w-0">
                      <span class="l-secret font-mono text-cream/85 break-all whitespace-pre-wrap" data-field={field}>••••••••••</span>
                      <button class="l-reveal font-mono text-[9px] uppercase text-slate hover:text-electric shrink-0" data-field={field}>Reveal</button>
                      <button class="l-copy font-mono text-[9px] uppercase text-slate hover:text-electric shrink-0" data-field={field}>Copy</button>
                    </span>
                  </>
                ))}
                {l.notes && (
                  <>
                    <span class="text-slate/50">Notes</span>
                    <span class="text-cream/75 whitespace-pre-wrap">{l.notes}</span>
                  </>
                )}
              </div>
              <p class="font-mono text-[9px] text-slate/30 mt-1.5">updated {fmt(l.updated_at)}{l.updated_by ? ` · ${l.updated_by}` : ''}</p>
            </div>
          ))}
        </div>

        <div id="login-form" class="mt-4 border-t border-white/10 pt-4" hidden>
          <p id="lf-title" class="font-mono text-[9px] uppercase tracking-widest text-slate/50 mb-2">Add login</p>
          <div class="grid md:grid-cols-2 gap-2">
            <div class="relative">
              <input id="lf-service" placeholder="Service * — Resend, Gmail, GoDaddy…" class="w-full bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="lf-suggest" />
              <ul id="lf-suggest" role="listbox" class="absolute left-0 right-0 top-full mt-1 z-20 max-h-56 overflow-y-auto bg-navy border border-white/15 shadow-xl shadow-black/50" hidden>
                {SERVICES.map((s) => <li role="option" data-v={s} class="px-3 py-1.5 text-[13px] text-cream/85 cursor-pointer hover:bg-white/[0.06]">{s}</li>)}
              </ul>
            </div>
            <select id="lf-site" class="bg-navy border border-white/10 px-3 py-2 text-[13px] text-cream/85">
              <option value="">For all of {client.name}’s sites</option>
              {(sites ?? []).map((s) => <option value={s.id}>{s.name}</option>)}
            </select>
            <input id="lf-url" placeholder="Login page URL" class="bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" autocomplete="off" />
            <input id="lf-user" placeholder="Username / email" class="bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" autocomplete="off" />
            <div class="flex gap-1"><input id="lf-pass" type="password" placeholder="Password" class="flex-1 min-w-0 bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" autocomplete="new-password" /><button type="button" class="lf-eye font-mono text-[9px] uppercase px-2 border border-white/10 text-slate hover:text-cream" data-for="lf-pass">Show</button></div>
            <div class="flex gap-1"><input id="lf-key" type="password" placeholder="API key / token" class="flex-1 min-w-0 bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" autocomplete="off" /><button type="button" class="lf-eye font-mono text-[9px] uppercase px-2 border border-white/10 text-slate hover:text-cream" data-for="lf-key">Show</button></div>
          </div>
          <textarea id="lf-secret" rows="2" placeholder="Recovery codes / 2FA notes — encrypted" class="w-full bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90 mt-2" autocomplete="off"></textarea>
          <textarea id="lf-notes" rows="2" placeholder="Notes — NOT encrypted (no passwords here)" class="w-full bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90 mt-2"></textarea>
          <div id="lf-clear" class="flex flex-wrap gap-3 mt-2 font-mono text-[10px] text-slate/60" hidden>
            <span>Leave a secret blank to keep the saved one.</span>
            <label class="lf-clear-row flex items-center gap-1" data-field="password"><input type="checkbox" class="lf-clear-box" value="password" /> remove saved password</label>
            <label class="lf-clear-row flex items-center gap-1" data-field="api_key"><input type="checkbox" class="lf-clear-box" value="api_key" /> remove saved API key</label>
            <label class="lf-clear-row flex items-center gap-1" data-field="secret_notes"><input type="checkbox" class="lf-clear-box" value="secret_notes" /> remove saved recovery notes</label>
          </div>
          <div class="flex items-center gap-2 mt-3">
            <button id="lf-save" class="font-mono text-[10px] uppercase tracking-widest px-4 py-2 border border-emerald-500/40 text-emerald-400 hover:bg-emerald-500/10">Save login</button>
            <button id="lf-cancel" class="font-mono text-[10px] uppercase tracking-widest px-3 py-2 border border-white/10 text-slate hover:text-cream">Cancel</button>
            <span id="lf-msg" class="font-mono text-[11px] text-slate/50"></span>
          </div>
        </div>
      </div>

      <!-- Deals -->
      <div class="border border-white/5 bg-navy p-5">
        <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-3">// Deals ({(deals ?? []).length})</p>
        {(deals ?? []).length === 0 && <p class="text-slate/50 text-[13px]">No deals yet. Assign one from the <a href="/admin/deals" class="text-electric hover:underline">deals page</a>.</p>}
        <div class="flex flex-col gap-2">
          {(deals ?? []).map((d) => (
            <div class="border-b border-white/5 pb-2">
              <div class="flex items-center justify-between gap-3">
                <span class="text-cream/90 text-[13px] truncate">{d.name}</span>
                <span class="flex items-center gap-2 shrink-0">
                  <span class={`font-mono text-[9px] uppercase tracking-widest ${stageColor(d.stage)}`}>{d.stage.replace(/_/g, ' ')}</span>
                  {d.value_estimate && <span class="font-mono text-[10px] text-slate/50">${Number(d.value_estimate).toLocaleString()}</span>}
                </span>
              </div>
              {d.next_action && <p class="font-mono text-[10px] text-slate/50 mt-0.5">→ {d.next_action}{d.next_action_due ? ` (${fmt(d.next_action_due)})` : ''}</p>}
            </div>
          ))}
        </div>
      </div>

      <!-- JANET threads -->
      <div class="border border-white/5 bg-navy p-5">
        <div class="flex items-center justify-between mb-3">
          <p class="font-mono text-[10px] tracking-widest uppercase text-electric">// JANET threads ({(threads ?? []).length})</p>
          <button id="new-thread" data-client-id={client.id} data-client-name={client.name} class="font-mono text-[9px] tracking-widest uppercase text-slate hover:text-electric px-2 py-1 border border-white/10 transition-colors">+ New thread</button>
        </div>
        {(threads ?? []).length === 0 && <p class="text-slate/50 text-[13px]">No threads yet. Start one to talk to JANET about {client.name} — she'll open with their full context.</p>}
        <div class="flex flex-col gap-1.5">
          {(threads ?? []).map((t) => (
            <button data-thread-id={t.id} class="open-thread flex items-center justify-between gap-3 text-left hover:text-electric transition-colors">
              <span class="text-cream/85 text-[13px] truncate">{t.title}</span>
              <span class="font-mono text-[9px] uppercase tracking-widest text-slate/40 shrink-0">{fmt(t.last_message_at)}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- JANET docs -->
      <div class="border border-white/5 bg-navy p-5">
        <div class="flex items-center justify-between mb-3">
          <p class="font-mono text-[10px] tracking-widest uppercase text-electric">// Docs ({(docs ?? []).length})</p>
          <button id="new-doc" data-client-id={client.id} class="font-mono text-[9px] tracking-widest uppercase text-slate hover:text-electric px-2 py-1 border border-white/10 transition-colors">+ New doc</button>
        </div>
        {(docs ?? []).length === 0 && <p class="text-slate/50 text-[13px]">No docs yet. Draft a proposal, scope, or campaign for {client.name} — JANET pre-fills from their context.</p>}
        <div class="flex flex-col gap-1.5">
          {(docs ?? []).map((d) => (
            <a href={`/admin/docs/${d.id}`} class="flex items-center justify-between gap-3 hover:text-electric transition-colors">
              <span class="text-cream/85 text-[13px] truncate">{d.title}</span>
              <span class="font-mono text-[9px] uppercase tracking-widest text-slate/40 shrink-0">{d.doc_type ?? ''} · {fmt(d.updated_at)}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Form responses -->
      {formResponses.length > 0 && (
        <div class="border border-white/5 bg-navy p-5">
          <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-3">// Form responses ({formResponses.length})</p>
          <div class="flex flex-col gap-1.5">
            {formResponses.map((r) => (
              <a href={`/admin/docs/${r.doc_id}`} class="flex items-center justify-between gap-3 border-b border-white/5 pb-2 hover:text-electric transition-colors">
                <span class="text-cream/85 text-[13px] truncate">{r.doc_title}{r.respondent_name ? ` — ${r.respondent_name}` : ''}</span>
                <span class="font-mono text-[9px] uppercase tracking-widest text-slate/50 shrink-0">{fmt(r.submitted_at)}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Published proposals -->
      {publishedPages.length > 0 && (
        <div class="border border-white/5 bg-navy p-5">
          <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-3">// Published ({publishedPages.length})</p>
          <div class="flex flex-col gap-1.5">
            {publishedPages.map((p) => (
              <div class="flex items-center justify-between gap-3 border-b border-white/5 pb-2">
                <a href={`/admin/docs/${p.doc_id}`} class="text-cream/85 text-[13px] truncate hover:text-electric transition-colors">{p.title}</a>
                <span class="flex items-center gap-3 shrink-0">
                  {p.published ? (
                    <a href={`https://blvstack.com/${p.slug}`} target="_blank" rel="noopener" class="font-mono text-[9px] text-electric hover:underline">/{p.slug} ↗</a>
                  ) : (
                    <span class="font-mono text-[9px] text-slate/40">offline</span>
                  )}
                  <span class="font-mono text-[9px] uppercase tracking-widest text-slate/50">{p.views} views</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Discovery notes -->
      <div class="border border-white/5 bg-navy p-5">
        <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-3">// Discovery notes ({notes.length})</p>
        {notes.length === 0 && <p class="text-slate/50 text-[13px]">No call notes yet. <a href="/admin/notepad" class="text-electric hover:underline">Open the notepad</a>.</p>}
        <div class="flex flex-col gap-1.5">
          {notes.map((n) => (
            <a href={`/admin/notepad`} class="flex items-center justify-between gap-3 hover:text-electric transition-colors">
              <span class="text-cream/85 text-[13px] truncate">{n.title ?? 'Untitled note'}</span>
              <span class="font-mono text-[9px] uppercase tracking-widest text-slate/40 shrink-0">{n.status} · {fmt(n.created_at)}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Side: info + approver + notes -->
    <div class="flex flex-col gap-4">
      <div class="border border-white/5 bg-navy p-5">
        <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-2">// Approver</p>
        {client.approver_name ? (
          <p class="text-cream/90 text-[13px]">{client.approver_name}<br /><span class="text-slate/60 text-[11px] font-mono">{client.approver_role ?? ''}{client.approver_email ? ` · ${client.approver_email}` : ''}</span></p>
        ) : (
          <p class="text-slate/50 text-[12px]">None set. This is who will own approvals for this client's actions when role-based approval is wired.</p>
        )}
      </div>
      {client.notes && (
        <div class="border border-white/5 bg-navy p-5">
          <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-2">// Notes</p>
          <p class="text-cream/90 text-[13px] leading-relaxed whitespace-pre-wrap">{client.notes}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Edit modal -->
  <div id="modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm grid place-items-center p-4">
    <div class="w-full max-w-lg bg-navy border border-white/10 shadow-2xl shadow-black/60 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-5 h-12 border-b border-white/10">
        <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-cream">Edit client</span>
        <button id="modal-close" class="text-slate hover:text-cream font-mono text-xs">✕</button>
      </div>
      <form id="client-form" class="p-5 flex flex-col gap-3" data-client={JSON.stringify(client)}>
        <div class="grid grid-cols-2 gap-3">
          <label class="col-span-2 flex flex-col gap-1"><span class="lbl">Account name *</span><input name="name" required class="fld" /></label>
          <label class="flex flex-col gap-1"><span class="lbl">Status</span>
            <select name="status" class="fld">{STATUSES.map((s) => <option value={s}>{s}</option>)}</select>
          </label>
          <label class="flex flex-col gap-1"><span class="lbl">Contact name</span><input name="contact_name" class="fld" /></label>
          <label class="flex flex-col gap-1"><span class="lbl">Contact email</span><input name="contact_email" type="email" class="fld" /></label>
          <label class="flex flex-col gap-1"><span class="lbl">Contact phone</span><input name="contact_phone" class="fld" /></label>
          <label class="col-span-2 flex flex-col gap-1"><span class="lbl">Notes</span><textarea name="notes" rows="2" class="fld resize-none"></textarea></label>
        </div>
        <div class="border-t border-white/10 pt-3">
          <p class="lbl mb-2 text-electric/70">// Approver</p>
          <div class="grid grid-cols-3 gap-3">
            <label class="flex flex-col gap-1"><span class="lbl">Name</span><input name="approver_name" class="fld" /></label>
            <label class="flex flex-col gap-1"><span class="lbl">Email</span><input name="approver_email" type="email" class="fld" /></label>
            <label class="flex flex-col gap-1"><span class="lbl">Role</span><input name="approver_role" class="fld" /></label>
          </div>
        </div>
        <div class="flex items-center justify-end gap-2 pt-1">
          <button type="button" id="modal-cancel" class="font-mono text-[10px] tracking-widest uppercase text-slate hover:text-cream px-3 py-2">Cancel</button>
          <button type="submit" class="bg-electric hover:bg-electric/90 text-navy font-mono text-[10px] tracking-widest uppercase px-4 py-2 transition-colors">Save</button>
        </div>
        <p id="form-err" class="font-mono text-[10px] text-red-400 hidden"></p>
      </form>
    </div>
  </div>
</AdminLayout>

<style>
  .lbl { font-family: monospace; font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: #64748B; }
  .fld { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 0.5rem 0.6rem; color: #FAF8F3; font-size: 13px; }
  .fld:focus { outline: none; border-color: rgba(37,99,235,0.5); }
  select.fld option { background: #0A1628; }
</style>

<script>
  const modal = document.getElementById('modal')!;
  const form = document.getElementById('client-form') as HTMLFormElement;
  const err = document.getElementById('form-err')!;
  const client = JSON.parse(form.dataset.client!);
  const id = client.id;
  const openModal = () => {
    for (const [k, v] of Object.entries(client)) {
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (el && v != null) el.value = String(v);
    }
    modal.classList.remove('hidden');
  };
  const close = () => modal.classList.add('hidden');
  document.getElementById('edit-client')!.addEventListener('click', openModal);
  document.getElementById('modal-close')!.addEventListener('click', close);
  document.getElementById('modal-cancel')!.addEventListener('click', close);
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });

  document.getElementById('del-client')!.addEventListener('click', async () => {
    if (!confirm(`Delete the account "${client.name}"? Its sites and deals keep their records (just unassigned).`)) return;
    const res = await fetch(`/api/admin/janet/clients/${id}`, { method: 'DELETE' });
    if (res.ok) location.href = '/admin/clients';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = Object.fromEntries(new FormData(form).entries());
    const res = await fetch(`/api/admin/janet/clients/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(fd),
    });
    if (res.ok) location.reload();
    else { const d = await res.json().catch(() => ({})); err.textContent = d.error ?? 'Save failed'; err.classList.remove('hidden'); }
  });

  // Threads (Feature 1): open one in the JANET panel, or create a new client-scoped thread.
  const openInPanel = (threadId: string) =>
    window.dispatchEvent(new CustomEvent('janet:open-thread', { detail: { threadId } }));

  document.querySelectorAll<HTMLButtonElement>('.open-thread').forEach((btn) =>
    btn.addEventListener('click', () => {
      const tid = btn.dataset.threadId;
      if (tid) openInPanel(tid);
    })
  );

  // New doc for this client (spec Feature 2). Picks a title + optional template.
  const newDocBtn = document.getElementById('new-doc');
  newDocBtn?.addEventListener('click', async () => {
    const clientId = (newDocBtn as HTMLElement).dataset.clientId;
    const title = prompt('Doc title:');
    if (!title) return;
    const template = prompt('Template? (proposal, scope, campaign, protocol, audit, brief — or leave blank)') || '';
    const payload: any = { title, client_id: clientId };
    if (template.trim()) { payload.template = template.trim(); payload.doc_type = template.trim(); }
    const res = await fetch('/api/janet/docs', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    if (res.ok) { const { doc } = await res.json(); location.href = `/admin/docs/${doc.id}`; }
  });

  const newThreadBtn = document.getElementById('new-thread');
  newThreadBtn?.addEventListener('click', async () => {
    const clientId = (newThreadBtn as HTMLElement).dataset.clientId;
    const clientName = (newThreadBtn as HTMLElement).dataset.clientName ?? 'client';
    const title = prompt(`Name this thread about ${clientName}:`, `${clientName} — discussion`);
    if (!title) return;
    const res = await fetch('/api/janet/threads', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title, client_id: clientId }),
    });
    if (res.ok) {
      const { thread } = await res.json();
      if (thread?.id) openInPanel(thread.id);
      location.reload();
    }
  });

  // ── Logins vault ─────────────────────────────────────────────────────────
  // Secrets never ship with the page: Reveal / Copy fetch ONE field (logged server-side). A revealed value
  // hides itself again after 30 seconds.
  const vault = document.getElementById('logins') as HTMLElement;
  const vaultApi = `/api/admin/janet/clients/${vault.dataset.client}/logins`;
  const vpost = async (body: Record<string, unknown>) => {
    const res = await fetch(vaultApi, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const d = await res.json().catch(() => ({}));
    if (!res.ok || !d.ok) throw new Error(d.error ?? 'Something went wrong');
    return d;
  };
  const rowOf = (el: Element) => el.closest('[data-login]') as HTMLElement;
  const loginOf = (el: Element) => JSON.parse(rowOf(el).dataset.login!);
  const flash = (btn: HTMLElement, text: string, back: string) => { btn.textContent = text; setTimeout(() => { btn.textContent = back; }, 1600); };
  const copyText = async (text: string) => {
    try { await navigator.clipboard.writeText(text); return true; } catch { window.prompt('Copy it:', text); return false; }
  };

  vault.querySelectorAll<HTMLButtonElement>('.l-copy-plain').forEach((b) => b.addEventListener('click', async () => {
    if (await copyText(b.dataset.v ?? '')) flash(b, 'Copied ✓', 'Copy');
  }));

  vault.querySelectorAll<HTMLButtonElement>('.l-reveal').forEach((b) => b.addEventListener('click', async () => {
    const field = b.dataset.field!;
    const span = rowOf(b).querySelector<HTMLElement>(`.l-secret[data-field="${field}"]`)!;
    if (b.textContent === 'Hide') { span.textContent = '••••••••••'; b.textContent = 'Reveal'; return; }
    b.textContent = '…';
    try {
      const { value } = await vpost({ action: 'reveal', id: loginOf(b).id, field });
      span.textContent = value ?? '(empty)';
      b.textContent = 'Hide';
      setTimeout(() => { if (b.textContent === 'Hide') { span.textContent = '••••••••••'; b.textContent = 'Reveal'; } }, 30000);
    } catch (e) { b.textContent = 'Reveal'; alert((e as Error).message); }
  }));

  vault.querySelectorAll<HTMLButtonElement>('.l-copy').forEach((b) => b.addEventListener('click', async () => {
    b.textContent = '…';
    try {
      const { value } = await vpost({ action: 'reveal', id: loginOf(b).id, field: b.dataset.field });
      if (await copyText(value ?? '')) flash(b, 'Copied ✓', 'Copy'); else b.textContent = 'Copy';
    } catch (e) { b.textContent = 'Copy'; alert((e as Error).message); }
  }));

  vault.querySelectorAll<HTMLButtonElement>('.l-del').forEach((b) => b.addEventListener('click', async () => {
    const l = loginOf(b);
    if (!confirm(`Delete the ${l.service} login? This can't be undone.`)) return;
    try { await vpost({ action: 'delete', id: l.id }); location.reload(); } catch (e) { alert((e as Error).message); }
  }));

  // Add / edit form
  const lform = document.getElementById('login-form') as HTMLElement;
  const f = (id: string) => document.getElementById(id) as HTMLInputElement;
  let editing: any = null;
  const openForm = (l: any | null) => {
    editing = l;
    document.getElementById('lf-title')!.textContent = l ? `Edit ${l.service} login` : 'Add login';
    f('lf-service').value = l?.service ?? '';
    (document.getElementById('lf-site') as HTMLSelectElement).value = l?.site_id ?? '';
    f('lf-url').value = l?.login_url ?? '';
    f('lf-user').value = l?.username ?? '';
    f('lf-notes').value = l?.notes ?? '';
    for (const [id, has] of [['lf-pass', l?.has_password], ['lf-key', l?.has_api_key], ['lf-secret', l?.has_secret_notes]] as const) {
      f(id).value = '';
      f(id).placeholder = has ? '•••••• saved — type to replace' : (id === 'lf-pass' ? 'Password' : id === 'lf-key' ? 'API key / token' : 'Recovery codes / 2FA notes — encrypted');
    }
    const clear = document.getElementById('lf-clear') as HTMLElement;
    clear.hidden = !l || !(l.has_password || l.has_api_key || l.has_secret_notes);
    clear.querySelectorAll<HTMLElement>('.lf-clear-row').forEach((row) => {
      const field = row.dataset.field!;
      row.hidden = !l?.[`has_${field}`];
      (row.querySelector('input') as HTMLInputElement).checked = false;
    });
    document.getElementById('lf-msg')!.textContent = '';
    lform.hidden = false;
    f('lf-service').focus();
  };
  // Service suggestions: our own list, anchored under the field (the browser's datalist popup floated off it).
  // Opens on click or typing, filters as you type, ↑/↓ + Enter to pick, Esc or clicking away closes.
  const svc = f('lf-service');
  const sug = document.getElementById('lf-suggest') as HTMLElement;
  const opts = Array.from(sug.querySelectorAll<HTMLElement>('li'));
  let active = -1;
  const visibleOpts = () => opts.filter((li) => !li.hidden);
  const paint = () => opts.forEach((li) => li.classList.toggle('bg-white/[0.08]', visibleOpts()[active] === li));
  const closeSug = () => { sug.hidden = true; svc.setAttribute('aria-expanded', 'false'); active = -1; paint(); };
  const openSug = () => {
    const q = svc.value.trim().toLowerCase();
    opts.forEach((li) => { li.hidden = !!q && !li.dataset.v!.toLowerCase().includes(q); });
    if (!visibleOpts().length) return closeSug();
    sug.hidden = false; svc.setAttribute('aria-expanded', 'true'); active = -1; paint();
  };
  svc.addEventListener('input', openSug);
  svc.addEventListener('mousedown', () => { if (sug.hidden) setTimeout(openSug, 0); });
  svc.addEventListener('blur', () => setTimeout(closeSug, 120));
  svc.addEventListener('keydown', (e) => {
    if (sug.hidden && e.key === 'ArrowDown') { openSug(); e.preventDefault(); return; }
    if (sug.hidden) return;
    const vis = visibleOpts();
    if (e.key === 'ArrowDown') { active = Math.min(active + 1, vis.length - 1); paint(); vis[active]?.scrollIntoView({ block: 'nearest' }); e.preventDefault(); }
    else if (e.key === 'ArrowUp') { active = Math.max(active - 1, 0); paint(); vis[active]?.scrollIntoView({ block: 'nearest' }); e.preventDefault(); }
    else if (e.key === 'Enter' && active >= 0) { svc.value = vis[active].dataset.v!; closeSug(); e.preventDefault(); }
    else if (e.key === 'Escape') { closeSug(); e.preventDefault(); }
  });
  opts.forEach((li) => li.addEventListener('mousedown', (e) => { e.preventDefault(); svc.value = li.dataset.v!; closeSug(); }));

  document.getElementById('login-add')!.addEventListener('click', () => openForm(null));
  vault.querySelectorAll<HTMLButtonElement>('.l-edit').forEach((b) => b.addEventListener('click', () => openForm(loginOf(b))));
  document.getElementById('lf-cancel')!.addEventListener('click', () => { lform.hidden = true; editing = null; });
  vault.querySelectorAll<HTMLButtonElement>('.lf-eye').forEach((b) => b.addEventListener('click', () => {
    const input = f(b.dataset.for!);
    input.type = input.type === 'password' ? 'text' : 'password';
    b.textContent = input.type === 'password' ? 'Show' : 'Hide';
  }));
  document.getElementById('lf-save')!.addEventListener('click', async () => {
    const msg = document.getElementById('lf-msg')!;
    if (!f('lf-service').value.trim()) { msg.textContent = 'Name the service.'; return; }
    const clearing = new Set(Array.from(vault.querySelectorAll<HTMLInputElement>('.lf-clear-box:checked')).map((c) => c.value));
    // a typed secret replaces; "remove" clears ('' ); blank leaves the saved one (undefined)
    const secret = (id: string, field: string) => {
      const v = f(id).value;
      if (v) return v;
      if (clearing.has(field)) return '';
      return editing ? undefined : null;
    };
    msg.textContent = 'Saving…';
    try {
      await vpost({
        action: 'save', id: editing?.id ?? null,
        service: f('lf-service').value, site_id: (document.getElementById('lf-site') as HTMLSelectElement).value || null,
        login_url: f('lf-url').value, username: f('lf-user').value, notes: f('lf-notes').value,
        password: secret('lf-pass', 'password'), api_key: secret('lf-key', 'api_key'), secret_notes: secret('lf-secret', 'secret_notes'),
      });
      msg.textContent = '✓ saved';
      setTimeout(() => location.reload(), 400);
    } catch (e) { msg.textContent = (e as Error).message; }
  });
</script>
