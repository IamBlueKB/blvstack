---
// Distinct-path create page backing the installable "BLVSTACK Invoice" home-screen
// app. Its own URL path gives it its own PWA scope, separate from the Clear Ear app.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import InvoiceCreator from '../../../components/clearear/InvoiceCreator.astro';

export const prerender = false;
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect('/admin');
---

<AdminLayout title="New BLVSTACK Invoice" adminEmail={adminEmail} active="clearear-invoices">
  <Fragment slot="head">
    <link rel="manifest" href="/manifest/clearear-invoice.webmanifest?business=blvstack" />
    <link rel="apple-touch-icon" href="/blvstack-appicon-192.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="BLV Invoice" />
    <meta name="theme-color" content="#0A1628" />
  </Fragment>
  <InvoiceCreator business="blvstack" />
</AdminLayout>
