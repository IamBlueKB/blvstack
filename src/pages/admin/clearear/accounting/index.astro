---
// Clear Ear Studios — accounting. What was actually COLLECTED (money in) vs what was
// BILLED, month by month, plus what's still owed and who owes it. Grounded entirely
// in stored rows via getStudioIntelligence — collected and billed are never blurred.
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getStudioIntelligence, getBooks, get1099 } from '../../../../lib/janet/clearear/intelligence';

export const prerender = false;
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect('/admin');

const thisYear = new Date().getUTCFullYear();
const yearParam = Astro.url.searchParams.get('year');
const year = yearParam === 'all' ? undefined : Number(yearParam) || thisYear;
// Three first-class views: each business's own books, and the COMBINED entity P&L
// (the filing number — one legal entity, one return).
const bParam = Astro.url.searchParams.get('business') ?? 'clearear';
const business: 'clearear' | 'blvstack' | 'all' = bParam === 'blvstack' ? 'blvstack' : bParam === 'all' ? 'all' : 'clearear';
const bizLabel = business === 'all' ? 'Combined (entity)' : business === 'blvstack' ? 'BLVSTACK' : 'Clear Ear Studios';
// 1099 is filed by the ENTITY, so it is always entity-wide regardless of the view.
const [intel, books, contractors] = await Promise.all([
  getStudioIntelligence({ business, year }),
  getBooks({ business, year }),
  get1099(year ?? thisYear, 'all'),
]);
const qs = (over: Record<string, string>) => {
  const p = new URLSearchParams({ business, ...(yearParam ? { year: yearParam } : {}), ...over });
  return p.toString();
};
const plMonths = Object.entries(books.by_month).sort((a, b) => (a[0] < b[0] ? 1 : -1));
const exportYear = year ?? 'all';
const exp1099Year = year ?? thisYear;

const usd = (n: number) => (Number(n) || 0).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
const months = Object.entries(intel.collected.by_month).sort((a, b) => (a[0] < b[0] ? 1 : -1));
const maxMonth = Math.max(1, ...months.map(([, v]) => v));
const methods = Object.entries(intel.collected.by_method).sort((a, b) => b[1] - a[1]);
const totalBilledByService = intel.billed_by_service.reduce((s, r) => s + r.billed, 0);
const ag = intel.receivables.aging;
const monthLabel = (k: string) => new Date(k + '-01T00:00:00Z').toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const years = [thisYear, thisYear - 1, thisYear - 2];
---

<AdminLayout title="Accounting" adminEmail={adminEmail} active="clearear-accounting">
  <div class="mb-6">
    <a href="/admin/clearear" class="font-mono text-[10px] text-slate/50 hover:text-electric">← Studio</a>
    <div class="flex items-end justify-between gap-4 mt-2 flex-wrap">
      <div>
        <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-electric mb-1">// Clear Ear · Books</p>
        <h1 class="text-3xl font-bold tracking-tight text-cream">Accounting — {bizLabel}</h1>
        <div class="flex gap-1.5 mt-2">
          {[['clearear','Clear Ear'],['blvstack','BLVSTACK'],['all','Combined']].map(([k,label]) => (
            <a href={`/admin/clearear/accounting?${qs({ business: k })}`} class={`font-mono text-[9px] tracking-widest uppercase px-2.5 py-1.5 border transition-colors ${business === k ? 'bg-electric text-navy border-electric' : 'border-white/10 text-slate hover:text-cream'}`}>{label}</a>
          ))}
        </div>
        <p class="font-mono text-[11px] text-slate/50 mt-1">{intel.window} · as of {intel.as_of}</p>
      </div>
      <div class="flex gap-1.5">
        {years.map((y) => (
          <a href={`/admin/clearear/accounting?business=${business}&year=${y}`} class={`font-mono text-[9px] tracking-widest uppercase px-2.5 py-1.5 border transition-colors ${year === y ? 'bg-electric text-navy border-electric' : 'border-white/10 text-slate hover:text-cream'}`}>{y}</a>
        ))}
        <a href={`/admin/clearear/accounting?business=${business}&year=all`} class={`font-mono text-[9px] tracking-widest uppercase px-2.5 py-1.5 border transition-colors ${!year ? 'bg-electric text-navy border-electric' : 'border-white/10 text-slate hover:text-cream'}`}>All time</a>
      </div>
    </div>
  </div>

  <!-- Headline: money in, money out, and the TWO net numbers -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-3">
    <div class="bg-navy border border-emerald-500/20 p-5">
      <p class="text-emerald-400 text-3xl font-semibold">{usd(books.collected)}</p>
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/50 mt-1">collected · money in</p>
    </div>
    <a href="/admin/clearear/expenses" class="bg-navy border border-white/5 p-5 hover:border-white/15 transition-colors">
      <p class="text-cream text-3xl font-semibold">{usd(books.expenses_total)}</p>
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/50 mt-1">expenses · money out</p>
    </a>
    <div class={`bg-navy border p-5 ${books.net_cash >= 0 ? 'border-emerald-500/20' : 'border-red-500/25'}`}>
      <p class={`text-3xl font-semibold ${books.net_cash >= 0 ? 'text-emerald-400' : 'text-red-400'}`}>{usd(books.net_cash)}</p>
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/50 mt-1">net cash · in − all out</p>
    </div>
    <div class="bg-navy border border-electric/20 p-5">
      <p class="text-electric text-3xl font-semibold">{usd(books.net_taxable)}</p>
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/50 mt-1">net taxable · est. before filing</p>
    </div>
  </div>
  <div class="grid sm:grid-cols-2 gap-3 mb-4">
    <div class="bg-navy border border-white/5 p-4">
      <p class="text-cream/85 text-xl font-semibold">{usd(totalBilledByService)}</p>
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/50 mt-1">billed · not necessarily paid</p>
    </div>
    <a href="/admin/clearear/invoices" class="bg-navy border border-amber-400/20 p-4 hover:border-amber-400/40 transition-colors">
      <p class="text-amber-400 text-xl font-semibold">{usd(intel.receivables.outstanding_total)}</p>
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/50 mt-1">outstanding · {intel.receivables.count} invoice{intel.receivables.count === 1 ? '' : 's'} (all-time)</p>
    </a>
  </div>

  <!-- Net taxable breakdown, so the estimate isn't a black box -->
  <div class="bg-navy border border-electric/15 p-4 mb-4">
    <p class="font-mono text-[9px] uppercase tracking-widest text-electric/70 mb-2">Net taxable = collected − deductible expenses − mileage</p>
    <div class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-[12px]">
      <span class="text-slate/60">collected <span class="text-cream/85">{usd(books.collected)}</span></span>
      <span class="text-slate/60">− deductible expenses <span class="text-cream/85">{usd(books.deductible_expenses)}</span></span>
      <span class="text-slate/60">− mileage <span class="text-cream/85">{usd(books.mileage_deduction)}</span></span>
      <span class="text-slate/60">= <span class="text-electric font-semibold">{usd(books.net_taxable)}</span></span>
    </div>
  </div>

  <!-- P&L by month -->
  <div class="bg-navy border border-white/5 mb-4">
    <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Profit & loss by month <span class="text-slate/25 normal-case">· cash basis</span></p>
    {plMonths.length === 0 ? (
      <p class="text-slate/40 text-sm px-4 py-6">No activity in this period.</p>
    ) : (
      <ul class="flex flex-col divide-y divide-white/5">
        <li class="flex items-center gap-3 px-4 py-2 font-mono text-[9px] uppercase tracking-widest text-slate/35">
          <span class="w-24 shrink-0">Month</span>
          <span class="flex-1 text-right">Collected</span>
          <span class="flex-1 text-right">Expenses</span>
          <span class="flex-1 text-right">Net</span>
        </li>
        {plMonths.map(([k, v]) => (
          <li class="flex items-center gap-3 px-4 py-2.5 text-[13px]">
            <span class="font-mono text-[11px] text-slate/60 w-24 shrink-0">{monthLabel(k)}</span>
            <span class="flex-1 text-right text-emerald-400/90">{usd(v.collected)}</span>
            <span class="flex-1 text-right text-cream/75">{usd(v.expenses)}</span>
            <span class={`flex-1 text-right font-semibold ${v.net_cash >= 0 ? 'text-emerald-400' : 'text-red-400'}`}>{usd(v.net_cash)}</span>
          </li>
        ))}
        <li class="flex items-center gap-3 px-4 py-2.5 text-[13px] border-t border-white/10">
          <span class="font-mono text-[10px] uppercase tracking-widest text-slate/50 w-24 shrink-0">Total</span>
          <span class="flex-1 text-right text-emerald-400 font-semibold">{usd(books.collected)}</span>
          <span class="flex-1 text-right text-cream/85 font-semibold">{usd(books.expenses_total)}</span>
          <span class={`flex-1 text-right font-semibold ${books.net_cash >= 0 ? 'text-emerald-400' : 'text-red-400'}`}>{usd(books.net_cash)}</span>
        </li>
      </ul>
    )}
  </div>

  <!-- Expenses by category -->
  <div class="bg-navy border border-white/5 mb-4">
    <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Expenses by category</p>
    {books.expenses_by_category.length === 0 ? (
      <p class="text-slate/40 text-sm px-4 py-6">No expenses logged in this period. <a href="/admin/clearear/expenses" class="text-electric">Log one →</a></p>
    ) : (
      <ul class="flex flex-col divide-y divide-white/5">
        {books.expenses_by_category.map((c) => (
          <li class="flex items-center justify-between gap-3 px-4 py-2.5">
            <span class="text-cream/80 text-[13px]">{c.label}</span>
            <span class="text-cream/85 text-sm">{usd(c.amount)}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="grid lg:grid-cols-3 gap-4">
    <!-- Collected by month -->
    <div class="lg:col-span-2 bg-navy border border-white/5">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Collected by month</p>
      {months.length === 0 ? (
        <p class="text-slate/40 text-sm px-4 py-6">No payments recorded in this period.</p>
      ) : (
        <ul class="flex flex-col divide-y divide-white/5">
          {months.map(([k, v]) => (
            <li class="flex items-center gap-3 px-4 py-2.5">
              <span class="font-mono text-[11px] text-slate/60 w-24 shrink-0">{monthLabel(k)}</span>
              <span class="flex-1 h-2 bg-white/[0.04] rounded-sm overflow-hidden">
                <span class="block h-full bg-emerald-500/60" style={`width:${Math.max(2, Math.round((v / maxMonth) * 100))}%`}></span>
              </span>
              <span class="text-cream/85 text-sm w-24 text-right shrink-0">{usd(v)}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- How they paid -->
    <div class="bg-navy border border-white/5">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">How they paid</p>
      {methods.length === 0 ? (
        <p class="text-slate/40 text-sm px-4 py-6">No payments yet.</p>
      ) : (
        <ul class="flex flex-col divide-y divide-white/5">
          {methods.map(([m, v]) => (
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="text-cream/80 text-[13px] capitalize">{m}</span>
              <span class="text-cream/85 text-sm">{usd(v)}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Receivables aging -->
    <div class="bg-navy border border-white/5">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Owed to you · aging</p>
      <ul class="flex flex-col divide-y divide-white/5 text-[13px]">
        <li class="flex justify-between px-4 py-2.5"><span class="text-slate/60">Not yet due</span><span class="text-cream/85">{usd(ag.current)}</span></li>
        <li class="flex justify-between px-4 py-2.5"><span class="text-slate/60">1–30 days late</span><span class="text-amber-400/90">{usd(ag.d1_30)}</span></li>
        <li class="flex justify-between px-4 py-2.5"><span class="text-slate/60">31–60 days late</span><span class="text-amber-400">{usd(ag.d31_60)}</span></li>
        <li class="flex justify-between px-4 py-2.5"><span class="text-slate/60">60+ days late</span><span class="text-red-400">{usd(ag.d60_plus)}</span></li>
      </ul>
    </div>

    <!-- Billed by service -->
    <div class="lg:col-span-2 bg-navy border border-white/5">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Billed by service <span class="text-slate/25 normal-case">· what you invoiced, not what cleared</span></p>
      {intel.billed_by_service.length === 0 ? (
        <p class="text-slate/40 text-sm px-4 py-6">Nothing billed in this period.</p>
      ) : (
        <ul class="flex flex-col divide-y divide-white/5">
          {intel.billed_by_service.map((s) => (
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="text-cream/80 text-[13px] truncate">{s.service}</span>
              <span class="font-mono text-[10px] text-slate/40 shrink-0">{s.lines} line{s.lines === 1 ? '' : 's'}</span>
              <span class="text-cream/85 text-sm w-24 text-right shrink-0">{usd(s.billed)}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Top clients -->
    <div class="lg:col-span-2 bg-navy border border-white/5">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Top clients by money in</p>
      {intel.top_clients.length === 0 ? (
        <p class="text-slate/40 text-sm px-4 py-6">No client revenue yet.</p>
      ) : (
        <ul class="flex flex-col divide-y divide-white/5">
          {intel.top_clients.map((c) => (
            <li class="flex items-center gap-3 px-4 py-2.5">
              <span class="text-cream/85 text-[13px] flex-1 truncate">{c.contact}</span>
              <span class="font-mono text-[10px] text-slate/40 shrink-0">{c.sessions} session{c.sessions === 1 ? '' : 's'}</span>
              <span class="font-mono text-[10px] text-slate/40 w-24 text-right shrink-0">billed {usd(c.billed)}</span>
              <span class="text-emerald-400/90 text-sm w-24 text-right shrink-0">{usd(c.collected)}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Lapsed -->
    <div class="bg-navy border border-white/5">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Gone quiet</p>
      {intel.lapsed_clients.length === 0 ? (
        <p class="text-slate/40 text-sm px-4 py-6">Nobody's lapsed.</p>
      ) : (
        <ul class="flex flex-col divide-y divide-white/5">
          {intel.lapsed_clients.map((c) => (
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="text-cream/80 text-[13px] truncate">{c.contact}</span>
              <span class="font-mono text-[10px] text-slate/50 shrink-0">{c.days}d</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <!-- 1099-NEC contractors -->
  <div class="bg-navy border border-white/5 mb-4">
    <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Contractors · 1099-NEC {exp1099Year} <span class="text-slate/25 normal-case">· ≥ $600, excludes card/app (1099-K) & corporations</span></p>
    {contractors.required.length === 0 && contractors.excluded.length === 0 ? (
      <p class="text-slate/40 text-sm px-4 py-5">No contractors at or over $600 for {exp1099Year}.</p>
    ) : (
      <ul class="flex flex-col divide-y divide-white/5">
        {contractors.required.map((c) => (
          <li class="flex items-center justify-between gap-3 px-4 py-2.5">
            <span class="text-cream/85 text-[13px]">{c.contact}{!c.tax_id_on_file && <span class="font-mono text-[9px] text-red-400 ml-2">⚠ W-9 MISSING</span>}</span>
            <span class="text-cream/85 text-sm">{usd(c.total)}</span>
          </li>
        ))}
        {contractors.excluded.map((e) => (
          <li class="flex items-center justify-between gap-3 px-4 py-2 opacity-60">
            <span class="text-slate/60 text-[12px]">{e.contact} <span class="text-slate/40">· {e.reason}</span></span>
            <span class="text-slate/60 text-[12px]">{usd(e.total)}</span>
          </li>
        ))}
      </ul>
    )}
    {contractors.missing_w9.length > 0 && (
      <p class="font-mono text-[10px] text-red-400/80 px-4 py-2 border-t border-white/5">Collect a W-9 before issuing: {contractors.missing_w9.join(', ')}</p>
    )}
  </div>

  <!-- Exports -->
  <div class="bg-navy border border-white/5 p-4 mb-4">
    <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 mb-3">Export for your accountant (CSV)</p>
    <div class="flex flex-wrap gap-2">
      <a href={`/api/admin/clearear/export?type=income&business=${business}&year=${exportYear}`} class="font-mono text-[9px] uppercase tracking-widest px-3 py-1.5 border border-white/10 text-slate hover:text-electric hover:border-electric/40">Income</a>
      <a href={`/api/admin/clearear/export?type=expenses&business=${business}&year=${exportYear}`} class="font-mono text-[9px] uppercase tracking-widest px-3 py-1.5 border border-white/10 text-slate hover:text-electric hover:border-electric/40">Expenses</a>
      <a href={`/api/admin/clearear/export?type=pl&business=${business}&year=${exportYear}`} class="font-mono text-[9px] uppercase tracking-widest px-3 py-1.5 border border-white/10 text-slate hover:text-electric hover:border-electric/40">P&L</a>
      <a href={`/api/admin/clearear/export?type=mileage&business=${business}&year=${exportYear}`} class="font-mono text-[9px] uppercase tracking-widest px-3 py-1.5 border border-white/10 text-slate hover:text-electric hover:border-electric/40">Mileage</a>
      <a href={`/api/admin/clearear/export?type=1099&business=all&year=${exp1099Year}`} class="font-mono text-[9px] uppercase tracking-widest px-3 py-1.5 border border-white/10 text-slate hover:text-electric hover:border-electric/40">1099 ({exp1099Year})</a>
    </div>
  </div>

  <p class="font-mono text-[10px] text-slate/35 mt-4 leading-relaxed">{books.basis}</p>
  <p class="font-mono text-[10px] text-slate/35 mt-1 leading-relaxed">{intel.note}</p>
</AdminLayout>
