---
// Clear Ear / BLVSTACK — create an invoice (query-param entry point, used by the
// in-app "+ New invoice" links). The form itself lives in InvoiceCreator; the two
// installable home-screen apps use the distinct /new-ce-invoice and /new-blv-invoice
// routes so Chrome can treat them as separate PWAs.
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import InvoiceCreator from '../../../../components/clearear/InvoiceCreator.astro';

export const prerender = false;
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect('/admin');
const bParam = Astro.url.searchParams.get('business') ?? 'clearear';
const business: 'clearear' | 'blvstack' = bParam === 'blvstack' ? 'blvstack' : 'clearear';
---

<AdminLayout title="New Invoice" adminEmail={adminEmail} active="clearear-invoices">
  <InvoiceCreator business={business} />
</AdminLayout>
