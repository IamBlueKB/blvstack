---
// Installable "Clear Ear Invoice" standalone app. Own path = own PWA scope (can't
// capture other admin URLs); minimal layout = no admin sidebar in the app window.
import InvoiceAppLayout from '../../../layouts/InvoiceAppLayout.astro';
import InvoiceCreator from '../../../components/clearear/InvoiceCreator.astro';

export const prerender = false;
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect('/admin');
---

<InvoiceAppLayout title="New Clear Ear Invoice" business="clearear">
  <InvoiceCreator business="clearear" mode="app" />
</InvoiceAppLayout>
