---
// BLV Books — Projects. A project groups the invoices for one piece of work
// (deposit + balance roll up here). total_value is the quote/contract value —
// PIPELINE, never revenue. Money columns come from the real invoice rows.
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../../../lib/supabase';
import { getProjectPipeline, PROJECT_STATUSES } from '../../../../lib/janet/clearear/projects';

export const prerender = false;
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect('/admin');

const bParam = Astro.url.searchParams.get('business') ?? 'clearear';
const business: 'clearear' | 'blvstack' = bParam === 'blvstack' ? 'blvstack' : 'clearear';
const bizLabel = business === 'blvstack' ? 'BLVSTACK' : 'Clear Ear';

const [pipeline, { data: contacts }] = await Promise.all([
  getProjectPipeline({ business }),
  supabaseAdmin.from('clearear_contacts').select('id, name').eq('business', business).eq('status', 'active').order('name'),
]);
const usd = (n: number) => (Number(n) || 0).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const statusColor: Record<string, string> = {
  proposed: 'border-slate/40 text-slate', active: 'border-electric/40 text-electric',
  on_hold: 'border-amber-500/50 text-amber-400', completed: 'border-emerald-500/40 text-emerald-400',
  cancelled: 'border-white/10 text-slate/40',
};
const ORDER = PROJECT_STATUSES;
---

<AdminLayout title="BLV Books · Projects" adminEmail={adminEmail} active="clearear-projects">
  <div class="mb-6">
    <a href={`/admin/clearear/accounting?business=${business}`} class="font-mono text-[10px] text-slate/50 hover:text-electric">← Accounting</a>
    <div class="flex items-end justify-between gap-4 mt-2 flex-wrap">
      <div>
        <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-electric mb-1">// {bizLabel} · Books</p>
        <h1 class="text-3xl font-bold tracking-tight text-cream">Projects — {bizLabel}</h1>
        <div class="flex gap-1.5 mt-2">
          {[['clearear','Clear Ear'],['blvstack','BLVSTACK']].map(([k,label]) => (
            <a href={`/admin/clearear/projects?business=${k}`} class={`font-mono text-[9px] tracking-widest uppercase px-2.5 py-1.5 border transition-colors ${business === k ? 'bg-electric text-navy border-electric' : 'border-white/10 text-slate hover:text-cream'}`}>{label}</a>
          ))}
        </div>
      </div>
      <div class="text-right">
        <p class="text-cream text-3xl font-semibold">{usd(pipeline.total_pipeline_value)}</p>
        <p class="font-mono text-[9px] uppercase tracking-widest text-slate/50">pipeline value · {pipeline.projects.length} project{pipeline.projects.length === 1 ? '' : 's'}</p>
      </div>
    </div>
    <p class="font-mono text-[10px] text-slate/40 mt-2">Pipeline value is quoted work, <span class="text-slate/60">not collected money</span> — revenue lives on the Accounting page.</p>
  </div>

  <!-- Pipeline by status -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-2 mb-6">
    {ORDER.map((st) => {
      const s = pipeline.by_status[st] ?? { count: 0, value: 0, invoiced: 0, outstanding: 0 };
      return (
        <div class="bg-navy border border-white/5 p-3">
          <p class={`font-mono text-[8px] uppercase tracking-widest px-1.5 py-0.5 border inline-block ${statusColor[st]}`}>{st.replace('_', ' ')}</p>
          <p class="text-cream text-xl font-semibold mt-2">{s.count}</p>
          <p class="font-mono text-[10px] text-slate/50">{usd(s.value)}</p>
        </div>
      );
    })}
  </div>

  <div class="grid lg:grid-cols-3 gap-4">
    <!-- Create -->
    <div class="bg-navy border border-white/5 p-4">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 mb-3">New project — {bizLabel}</p>
      <div class="flex flex-col gap-2">
        <select id="p-contact" class="bg-navy border border-white/10 px-3 py-2 text-[13px] text-cream/85">
          <option value="">Client…</option>
          {(contacts ?? []).map((c: any) => <option value={c.id}>{c.name}</option>)}
        </select>
        <input id="p-name" placeholder="Project name" class="bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" />
        <input id="p-value" inputmode="decimal" placeholder="Total value ($) — optional" class="bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" />
        <select id="p-status" class="bg-navy border border-white/10 px-3 py-2 text-[13px] text-cream/85">
          {ORDER.map((st) => <option value={st} selected={st === 'active'}>{st.replace('_', ' ')}</option>)}
        </select>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="font-mono text-[8px] uppercase tracking-widest text-slate/40">Start</label><input id="p-start" type="date" class="w-full bg-white/[0.03] border border-white/10 px-2 py-1.5 text-[12px] text-cream/90" /></div>
          <div><label class="font-mono text-[8px] uppercase tracking-widest text-slate/40">Target</label><input id="p-target" type="date" class="w-full bg-white/[0.03] border border-white/10 px-2 py-1.5 text-[12px] text-cream/90" /></div>
        </div>
        <textarea id="p-notes" rows="2" placeholder="Notes — optional" class="bg-white/[0.03] border border-white/10 px-3 py-2 text-[12px] text-cream/80 resize-y"></textarea>
        <button id="p-save" class="mt-1 font-mono text-[10px] uppercase tracking-widest px-4 py-2 border border-emerald-500/40 text-emerald-400 hover:bg-emerald-500/10">Create project</button>
        <p id="p-msg" class="font-mono text-[10px]"></p>
      </div>
    </div>

    <!-- List -->
    <div class="lg:col-span-2 bg-navy border border-white/5">
      <p class="font-mono text-[9px] uppercase tracking-widest text-slate/40 px-4 py-3 border-b border-white/5">Projects</p>
      {pipeline.projects.length === 0 ? (
        <p class="text-slate/40 text-sm px-4 py-6">No {bizLabel} projects yet.</p>
      ) : (
        <ul class="flex flex-col divide-y divide-white/5">
          {pipeline.projects.map((p: any) => (
            <li class="px-4 py-3">
              <div class="flex items-center gap-3">
                <span class={`font-mono text-[8px] uppercase tracking-widest px-1.5 py-0.5 border shrink-0 ${statusColor[p.status]}`}>{p.status.replace('_', ' ')}</span>
                <a href={`/admin/clearear/contacts/${p.contact_id}`} class="text-cream/90 text-sm flex-1 min-w-0 truncate hover:text-electric">{p.name}</a>
                <span class="font-mono text-[11px] text-slate/50 hidden md:block truncate">{p.contact_name}</span>
                <span class="text-cream/85 text-sm shrink-0 w-24 text-right">{p.total_value != null ? usd(p.total_value) : '—'}</span>
              </div>
              <div class="flex gap-4 mt-1.5 font-mono text-[10px] text-slate/50 pl-1">
                <span>invoiced <span class="text-cream/70">{usd(p.invoiced)}</span></span>
                <span>collected <span class="text-emerald-400/80">{usd(p.collected)}</span></span>
                <span>outstanding <span class="text-amber-400/80">{usd(p.outstanding)}</span></span>
                <span class="text-slate/30">{p.invoice_count} invoice{p.invoice_count === 1 ? '' : 's'}</span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</AdminLayout>

<script is:inline define:vars={{ BUSINESS: business }}>
  (function () {
    var btn = document.getElementById('p-save');
    function val(id) { var el = document.getElementById(id); return el && el.value.trim() ? el.value.trim() : null; }
    btn.addEventListener('click', async function () {
      var msg = document.getElementById('p-msg');
      var contact_id = document.getElementById('p-contact').value;
      var name = val('p-name');
      if (!contact_id) { msg.style.color = '#f87171'; msg.textContent = 'Pick a client.'; return; }
      if (!name) { msg.style.color = '#f87171'; msg.textContent = 'Name is required.'; return; }
      msg.style.color = ''; msg.textContent = 'Saving…';
      try {
        var res = await fetch('/api/admin/clearear/projects', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
          business: BUSINESS, contact_id: contact_id, name: name,
          total_value: val('p-value'), status: document.getElementById('p-status').value,
          start_date: val('p-start'), target_date: val('p-target'), notes: val('p-notes'),
        }) });
        var json = await res.json();
        if (res.ok && json.ok) { msg.style.color = '#34d399'; msg.textContent = '✓ created'; setTimeout(function () { location.reload(); }, 500); }
        else { msg.style.color = '#f87171'; msg.textContent = json.error || 'Error'; }
      } catch (e) { msg.style.color = '#f87171'; msg.textContent = 'Network error'; }
    });
  })();
</script>
