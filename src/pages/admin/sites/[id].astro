---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase';

export const prerender = false;
const adminEmail = Astro.locals.adminEmail;
const { id } = Astro.params;

const { data: site } = await supabaseAdmin.from('janet_sites').select('*').eq('id', id).maybeSingle();
if (!site) return Astro.redirect('/admin/sites');

// Client this site belongs to — scopes the JANET panel to that client (Feature 1).
let clientAccount: { id: string; name: string } | null = null;
if (site.client_id) {
  const { data } = await supabaseAdmin.from('janet_clients').select('id, name').eq('id', site.client_id).maybeSingle();
  clientAccount = data ?? null;
}

const { data: scans } = await supabaseAdmin
  .from('janet_site_scans')
  .select('id, scan_type, passed, failed, score, results, created_at')
  .eq('site_id', id)
  .order('created_at', { ascending: false })
  .limit(20);

// Hosting & billing: which Vercel project serves the site, which retainer pays for it, and the pause policy.
const [{ data: retainerRows }, linkedRet] = await Promise.all([
  supabaseAdmin.from('clearear_retainers').select('id, business, monthly_rate, status, billing_method, past_due_since, clearear_contacts(name)').neq('status', 'ended').order('created_at', { ascending: false }),
  site.billing_retainer_id ? supabaseAdmin.from('clearear_retainers').select('id, status, billing_method, monthly_rate, past_due_since, last_failure_reason, clearear_contacts(name)').eq('id', site.billing_retainer_id).maybeSingle().then((r) => r.data as any) : Promise.resolve(null),
]);
const retainerOptions = ((retainerRows ?? []) as any[]).map((r) => ({ id: r.id, label: `${r.clearear_contacts?.name ?? 'client'} — $${Number(r.monthly_rate).toFixed(2)}/mo ${r.billing_method === 'stripe_subscription' ? 'card' : 'invoice'} (${r.status})` }));
if (linkedRet && !retainerOptions.some((o) => o.id === linkedRet.id)) retainerOptions.unshift({ id: linkedRet.id, label: `${linkedRet.clearear_contacts?.name ?? 'client'} — $${Number(linkedRet.monthly_rate).toFixed(2)}/mo (${linkedRet.status})` });
const pauseOn = linkedRet?.past_due_since && site.auto_suspend ? new Date(new Date(linkedRet.past_due_since).getTime() + (Number(site.suspend_grace_days) || 7) * 86_400_000) : null;
const dayFmt = (d: string | Date) => new Date(d).toLocaleDateString('en-US', { timeZone: 'America/Chicago', month: 'short', day: 'numeric', year: 'numeric' });

const latest = scans?.[0];
const findings = latest?.results?.audit?.findings ?? [];
const sevColor = (s: string) => (s === 'critical' ? 'text-red-400' : s === 'high' ? 'text-amber-400' : s === 'medium' ? 'text-yellow-500' : 'text-slate/60');
const scoreColor = (n: number) => (n >= 90 ? 'text-emerald-400' : n >= 50 ? 'text-amber-400' : 'text-red-400');
const fmt = (iso: string) => new Date(iso).toLocaleString();
---

<AdminLayout title={site.name} adminEmail={adminEmail} active="janet-sites" janet={{ entity_type: 'site', entity_id: site.id, client_id: clientAccount?.id, client_name: clientAccount?.name }}>
  <a href="/admin/sites" class="font-mono text-[10px] tracking-widest uppercase text-slate hover:text-electric transition-colors">← Sites</a>

  <div class="flex items-start justify-between gap-3 mt-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-cream tracking-tight">{site.name}</h1>
      <a href={site.production_url} target="_blank" rel="noopener" class="font-mono text-[11px] text-slate/60 hover:text-electric transition-colors">{site.production_url} ↗</a>
      <p class="font-mono text-[10px] text-slate/50 mt-1">{site.status}{site.client_name ? ` · ${site.client_name}` : ''}{site.retainer_status !== 'none' ? ` · retainer ${site.retainer_status}` : ''}{site.repo_url ? ` · repo` : ''}</p>
    </div>
    <button id="run-scan" data-id={site.id} class="bg-electric hover:bg-electric/90 text-navy font-mono text-[10px] tracking-[0.25em] uppercase px-4 py-2.5 transition-colors">Run scan now</button>
  </div>
  <span id="scan-status" class="font-mono text-[11px] text-slate/60 block mb-6"></span>

  <!-- Hosting & billing: pause/restore + the non-payment policy (site-suspension.ts / dunning.ts) -->
  <div class="border border-white/5 bg-navy p-5 mb-4" id="hosting" data-id={site.id}>
    <div class="flex items-start justify-between gap-3 flex-wrap mb-4">
      <div>
        <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-2">// Hosting &amp; billing</p>
        {site.suspended_at ? (
          <p class="text-[13px] text-amber-400">● Paused since {dayFmt(site.suspended_at)} — visitors see the BLVSTACK “temporarily unavailable” page{site.suspended_reason ? ` (${site.suspended_reason})` : ''}.</p>
        ) : pauseOn ? (
          <p class="text-[13px] text-red-400">● Live, but payment is past due since {dayFmt(linkedRet.past_due_since)} — the site pauses automatically on {dayFmt(pauseOn)} unless it's paid.</p>
        ) : (
          <p class="text-[13px] text-emerald-400">● Live</p>
        )}
      </div>
      <div class="flex gap-2">
        {site.suspended_at
          ? <button id="h-restore" class="font-mono text-[10px] tracking-widest uppercase px-3 py-2 border border-emerald-500/40 text-emerald-400 hover:bg-emerald-500/10">Restore site</button>
          : <button id="h-suspend" class="font-mono text-[10px] tracking-widest uppercase px-3 py-2 border border-amber-500/40 text-amber-400 hover:bg-amber-500/10" disabled={!site.vercel_project_id} title={site.vercel_project_id ? '' : 'Link the Vercel project first'}>Pause site now</button>}
      </div>
    </div>
    <div class="grid md:grid-cols-2 gap-3">
      <label class="flex flex-col gap-1"><span class="font-mono text-[9px] uppercase tracking-widest text-slate/50">Vercel project (name or id)</span>
        <input id="h-project" value={site.vercel_project_id ?? ''} placeholder="e.g. djgurug" class="bg-white/[0.03] border border-white/10 px-3 py-2 text-[13px] text-cream/90" /></label>
      <label class="flex flex-col gap-1"><span class="font-mono text-[9px] uppercase tracking-widest text-slate/50">Paid for by</span>
        <select id="h-retainer" class="bg-navy border border-white/10 px-3 py-2 text-[13px] text-cream/85">
          <option value="">— not linked —</option>
          {retainerOptions.map((o) => <option value={o.id} selected={o.id === site.billing_retainer_id}>{o.label}</option>)}
        </select></label>
    </div>
    <label class="flex items-center gap-2 mt-3 text-[13px] text-cream/85">
      <input id="h-auto" type="checkbox" checked={site.auto_suspend} />
      Pause automatically when a card payment is
      <input id="h-days" type="number" min="1" max="60" value={site.suspend_grace_days ?? 7} class="w-14 bg-white/[0.03] border border-white/10 px-2 py-1 text-[13px] text-cream/90" />
      days past due
    </label>
    <p class="font-mono text-[10px] text-slate/40 mt-1">The client is emailed when the charge fails (with an update-card link), 2 days before the pause, when it pauses, and when it’s back. Paying restores the site automatically. A site you pause by hand stays paused until you restore it.</p>
    <div class="flex items-center gap-3 mt-3">
      <button id="h-save" class="font-mono text-[10px] tracking-widest uppercase px-4 py-2 border border-electric/40 text-electric hover:bg-electric/10">Save</button>
      <span id="h-msg" class="font-mono text-[11px] text-slate/50"></span>
    </div>
  </div>

  {site.notes && (
    <div class="border border-white/5 bg-navy p-5 mb-4">
      <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-2">// Notes</p>
      <p class="text-cream/90 text-[13px] leading-relaxed whitespace-pre-wrap">{site.notes}</p>
    </div>
  )}

  <div class="grid md:grid-cols-2 gap-4">
    <!-- Latest findings -->
    <div class="border border-white/5 bg-navy p-5">
      <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-3">// Latest findings</p>
      {!latest && <p class="text-slate/50 text-sm">No scans yet. Run one.</p>}
      {latest && findings.length === 0 && <p class="text-emerald-400 text-sm">Clean — no findings.</p>}
      <div class="flex flex-col gap-2">
        {findings.slice(0, 12).map((f: any) => (
          <div class="flex items-start gap-2">
            <span class={`font-mono text-[9px] uppercase tracking-wide mt-0.5 shrink-0 ${sevColor(f.severity)}`}>{f.severity}</span>
            <div>
              <p class="text-cream/90 text-[12px] leading-snug">{f.issue}</p>
              <p class="text-slate/50 text-[10px] leading-snug">{f.impact}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Scan history -->
    <div class="border border-white/5 bg-navy p-5">
      <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-3">// Scan history</p>
      {(!scans || scans.length === 0) && <p class="text-slate/50 text-sm">No scans yet.</p>}
      <div class="flex flex-col gap-1.5">
        {(scans ?? []).map((sc) => (
          <div class="flex items-center justify-between font-mono text-[11px] border-b border-white/5 pb-1.5">
            <span class="text-slate/60">{fmt(sc.created_at)}</span>
            <span class="flex items-center gap-3">
              <span class="text-emerald-400">{sc.passed ?? 0}✓</span>
              <span class="text-red-400">{sc.failed ?? 0}✕</span>
              <span class={`font-semibold ${scoreColor(sc.score ?? 0)}`}>{sc.score ?? '—'}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const btn = document.getElementById('run-scan') as HTMLButtonElement | null;
  const status = document.getElementById('scan-status')!;
  const id = btn?.dataset.id;
  btn?.addEventListener('click', async () => {
    btn.disabled = true;
    status.textContent = 'Scanning… (Lighthouse + headers + SSL + basics)';
    try {
      const res = await fetch(`/api/admin/janet/sites/${id}/scan`, { method: 'POST' });
      const d = await res.json();
      if (res.ok) { status.textContent = `Done — ${d.passed}✓ / ${d.failed}✕ · score ${d.score}. Reloading…`; setTimeout(() => location.reload(), 800); }
      else { status.textContent = 'Scan failed: ' + (d.error ?? 'unknown'); btn.disabled = false; }
    } catch (e) { status.textContent = 'Scan error'; btn.disabled = false; }
  });

  // Hosting & billing
  const hosting = document.getElementById('hosting') as HTMLElement;
  const hid = hosting.dataset.id;
  const hmsg = document.getElementById('h-msg')!;
  const hpost = async (body: Record<string, unknown>) => {
    hmsg.textContent = '…';
    try {
      const res = await fetch(`/api/admin/janet/sites/${hid}/hosting`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const d = await res.json();
      if (res.ok && d.ok) { hmsg.textContent = '✓ done'; setTimeout(() => location.reload(), 600); }
      else hmsg.textContent = d.error ?? 'Error';
    } catch { hmsg.textContent = 'Network error'; }
  };
  document.getElementById('h-save')?.addEventListener('click', () => hpost({
    action: 'save',
    vercel_project: (document.getElementById('h-project') as HTMLInputElement).value,
    billing_retainer_id: (document.getElementById('h-retainer') as HTMLSelectElement).value || null,
    auto_suspend: (document.getElementById('h-auto') as HTMLInputElement).checked,
    suspend_grace_days: Number((document.getElementById('h-days') as HTMLInputElement).value),
  }));
  document.getElementById('h-suspend')?.addEventListener('click', () => {
    if (!confirm('Pause this site now? Visitors will see the BLVSTACK “temporarily unavailable” page until you restore it.')) return;
    hpost({ action: 'suspend' });
  });
  document.getElementById('h-restore')?.addEventListener('click', () => {
    if (!confirm('Restore this site? It goes back online within seconds.')) return;
    hpost({ action: 'restore' });
  });
</script>
