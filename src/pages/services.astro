---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';

const TITLE = 'Services — BLVSTACK';
const DESC = 'What BLVSTACK builds and runs: custom websites, lead capture and booking, monthly care, AI and automation, and IT and infrastructure — scoped per project.';

const PILLARS = [
  {
    code: 'L1',
    tag: 'SITES',
    layerIndex: 0,
    slug: 'sites',
    label: 'Custom Websites',
    headline: 'Sites built around you.',
    overview: 'New builds and full refreshes, designed around your brand and fast on every device. Custom code, no templates, no page-builder lock-in, and you own all of it.',
    included: [
      'Brand-led design, desktop to phone',
      'Custom build, no templates',
      'Content you can update yourself',
      'SEO basics + fast load times',
      'Launch, handover, and on-call support through week one',
    ],
    ideal: 'Anyone who wants a new site, or needs the one they have to finally look and work right: artists, service businesses, practices, founders.',
    timeline: '2–3 week build · launch-ready',
    outcomes: [
      'A site that looks like you, not a template',
      'Fast on every device and easy to keep current',
      'Everything owned by you, nothing rented',
    ],
  },
  {
    code: 'L2',
    tag: 'LEADS',
    layerIndex: 1,
    slug: 'leads',
    label: 'Lead Capture & Booking',
    headline: 'Inquiries that arrive ready to answer.',
    overview: 'The parts that turn visitors into conversations: intake that asks the right questions, booking without phone tag, and every inquiry landing where you will see it.',
    included: [
      'Quote + inquiry forms',
      'Assessments + intake flows',
      'Booking + scheduling links',
      'Instant notifications',
      'Spam protection',
    ],
    ideal: 'Service businesses and practices where new work starts with an inquiry or an appointment.',
    timeline: '3–5 week build · with the site',
    outcomes: [
      'Inquiries arrive with the details you need',
      'Fewer calls just to find a time',
      'No lead lost in a DM',
    ],
  },
  {
    code: 'L3',
    tag: 'CARE',
    layerIndex: 2,
    slug: 'care',
    label: 'Follow-Up & Monthly Care',
    headline: 'Launch day is the start.',
    overview: 'We host it, monitor it, and keep it current, and can run the follow-up that turns inquiries into clients, month after month.',
    included: [
      'Hosting + uptime monitoring',
      'Security + performance updates',
      'Content and page updates',
      'Follow-up sequences, if you want them',
    ],
    ideal: 'Anyone who would rather not be their own web team after launch.',
    timeline: 'Monthly · starts at launch',
    outcomes: [
      'The site stays fast, secure, and current',
      'New inquiries get followed up',
      'One person to call when something needs to change',
    ],
  },
  {
    code: 'L4',
    tag: 'AI',
    layerIndex: 3,
    slug: 'ai',
    label: 'AI & Automation',
    headline: 'Agents and workflows that handle real work.',
    overview: 'Chat, voice, booking, and qualification agents that handle live conversations with real prospects, plus the automation layer that runs your repetitive admin without you. Tuned to your offer and your tone, observable, and owned by you, not duct-taped together with no-code subscriptions.',
    included: [
      'Custom AI agents: chat, voice, intake, qualification',
      'Tool-use integrations (CRM, calendar, billing)',
      'Workflow audit + bottleneck mapping',
      'Event-driven automations across your stack',
      'Conversation logging + monitoring',
    ],
    ideal: 'Founders and service businesses where intake, qualification, or admin currently bottlenecks on human bandwidth.',
    timeline: '2–4 week build · live in production',
    outcomes: [
      'Inbound qualification runs without staff',
      'Manual work moves to background jobs',
      'Adding capacity becomes configuration, not hiring',
    ],
  },
  {
    code: 'L5',
    tag: 'TECH',
    layerIndex: 4,
    slug: 'it',
    label: 'IT & Infrastructure',
    headline: 'We build your site and keep your tech running.',
    overview: 'The tech behind your business, set up properly and looked after: hosting, security, backups, email and devices, and your office network. Still on an old server? We’ll move you to the cloud. One studio for the site and everything behind it.',
    included: [
      'Managed cloud hosting, kept up and running',
      'Security: firewalls, VPN, and access control',
      'Backups and disaster recovery',
      'Uptime and performance monitoring',
      'Business IT setup: Microsoft 365, email, Teams, and device management',
      'Office networking: Wi-Fi, switches, firewalls, and multiple locations',
      'Cloud migration off old servers',
    ],
    ideal: 'Offices and small teams without an IT person: practices, firms, studios, and shops with more than one location.',
    timeline: 'Setup in 1–3 weeks · then monthly',
    outcomes: [
      'Email, accounts, and devices set up and secured',
      'Backups you can actually restore from',
      'One person to call when something breaks',
    ],
  },
];
---

<Base title={TITLE} description={DESC} ogImage="/og/services.png">

  <!-- ════════════════ HERO ════════════════ -->
  <section class="relative pt-48 pb-20 px-6 md:px-12 lg:px-16 max-w-7xl mx-auto">

    <div class="flex items-center gap-4 mb-10 opacity-0 animate-fade-up" style="animation-delay: 0.1s;">
      <span class="h-px w-10 bg-electric"></span>
      <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-electric">
        // Services
      </span>
    </div>

    <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] font-bold tracking-tight text-cream leading-[0.95] max-w-5xl opacity-0 animate-fade-up" style="animation-delay: 0.25s;">
      The site first.<br />
      <span class="text-electric">Then what it runs.</span>
    </h1>

    <p class="mt-14 text-base md:text-lg text-slate leading-relaxed max-w-xl opacity-0 animate-fade-up" style="animation-delay: 0.4s;">
      Every <Brand /> engagement starts with a custom site. Lead capture, booking, monthly care, and AI agents and automation are there when you need them. And when you’re ready, we keep the rest of your tech running too. Most projects start with one and add the rest.
    </p>
  </section>

  <!-- ════════════════ PILLAR SECTIONS ════════════════ -->
  {PILLARS.map((p, i) => (
    <div id={p.slug} class={i % 2 === 1 ? 'tone-cream blend-from-navy' : i > 0 ? 'tone-navy blend-from-cream' : ''}>
    <section class="relative px-6 md:px-12 lg:px-16 py-16 md:py-20 max-w-7xl mx-auto">

      <!-- Layer header -->
      <div class="flex items-center gap-3 mb-10">
        <span class="inline-flex flex-col gap-[2px]" aria-hidden="true" style="width: 14px;">
          <span class={`block h-[1.5px] w-full ${p.layerIndex === 0 ? 'bg-electric' : 'bg-slate/40'}`}></span>
          <span class={`block h-[1.5px] w-full ${p.layerIndex === 1 ? 'bg-electric' : 'bg-slate/40'}`}></span>
          <span class={`block h-[1.5px] w-full ${p.layerIndex === 2 ? 'bg-electric' : 'bg-slate/40'}`}></span>
          <span class={`block h-[1.5px] w-full ${p.layerIndex === 3 ? 'bg-electric' : 'bg-slate/40'}`}></span>
          <span class={`block h-[1.5px] w-full ${p.layerIndex === 4 ? 'bg-electric' : 'bg-slate/40'}`}></span>
        </span>
        <span class="font-mono text-[11px] tracking-widest uppercase text-slate">
          {p.code} · {p.tag}
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16">

        <!-- LEFT — title + overview -->
        <div class="md:col-span-7 flex flex-col gap-8">
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-cream leading-[0.95]">
            {p.label}
          </h2>

          <p class="text-2xl md:text-3xl font-bold text-electric tracking-tight leading-tight max-w-2xl">
            {p.headline}
          </p>

          <p class="text-base md:text-lg text-slate leading-relaxed max-w-2xl">
            {p.overview}
          </p>

          <!-- CTA -->
          <a
            href={`/start?service=${p.slug}`}
            class="cta-primary group self-start mt-4"
            data-magnetic
          >
            <span class="cta-primary-inner">
              <span class="cta-label">Start an {p.code} project</span>
              <svg class="cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
              </svg>
            </span>
          </a>
        </div>

        <!-- RIGHT — structured detail -->
        <div class="md:col-span-5 flex flex-col gap-px bg-white/5 self-start">

          <!-- What's included -->
          <div class="bg-navy p-6 md:p-8">
            <p class="font-mono text-[10px] tracking-widest uppercase text-electric mb-4">
              What's included
            </p>
            <ul class="space-y-3">
              {p.included.map((item) => (
                <li class="flex items-start gap-3 text-sm text-cream/85 leading-relaxed">
                  <span class="mt-[8px] w-3 h-px bg-electric/60 shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Ideal client -->
          <div class="bg-navy p-6 md:p-8">
            <p class="font-mono text-[10px] tracking-widest uppercase text-slate/60 mb-3">
              Ideal client
            </p>
            <p class="text-sm text-cream/85 leading-relaxed">
              {p.ideal}
            </p>
          </div>

          <!-- Timeline -->
          <div class="bg-navy p-6 md:p-8">
            <p class="font-mono text-[10px] tracking-widest uppercase text-slate/60 mb-3">
              Timeline
            </p>
            <p class="font-mono text-sm text-cream">
              {p.timeline}
            </p>
          </div>

          <!-- Example outcomes -->
          <div class="bg-navy p-6 md:p-8">
            <p class="font-mono text-[10px] tracking-widest uppercase text-slate/60 mb-3">
              Example outcomes
            </p>
            <ul class="space-y-2">
              {p.outcomes.map((o) => (
                <li class="flex items-start gap-3 text-sm text-cream/80 leading-relaxed">
                  <span class="text-electric/80 mt-[2px]">→</span>
                  <span>{o}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
    </div>
  ))}

  <!-- ════════════════ NOT SURE WHICH? ════════════════ -->
  <div class="tone-cream blend-from-navy">
  <section class="px-6 md:px-12 lg:px-16 py-20 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div>
        <p class="font-mono text-[11px] tracking-widest uppercase text-electric mb-4">
          // Unsure where you fit?
        </p>
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight text-cream max-w-xl leading-tight">
          Not sure what you need? Answer six questions and get a short brief back.
        </h3>
      </div>
      <a
        href="/assessment"
        class="font-mono text-xs tracking-[0.25em] uppercase text-cream hover:text-electric transition-colors duration-300 inline-flex items-center gap-3 self-start"
      >
        Take the free assessment
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M1 5H13M13 5L9 1M13 5L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </a>
    </div>
  </section>
  </div>

  <!-- ════════════════ CTA ════════════════ -->
  <section class="tone-electric blend-from-cream relative overflow-hidden px-6 md:px-12 lg:px-16 py-28">
    <div
      class="pointer-events-none absolute inset-0"
      style="
        background:
          radial-gradient(ellipse 80% 60% at 20% 50%, rgba(37,99,235,0.14) 0%, transparent 60%),
          radial-gradient(ellipse 60% 80% at 80% 30%, rgba(30,64,175,0.12) 0%, transparent 55%);
      "
      aria-hidden="true"
    ></div>

    <div class="relative max-w-7xl mx-auto flex flex-col items-start gap-10">
      <div class="flex items-center gap-4">
        <span class="h-px w-10 bg-electric"></span>
        <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-electric">
          // Ready
        </span>
      </div>

      <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-cream leading-[0.92] max-w-3xl">
        Tell us what you're<br />
        <span class="text-electric">trying to solve.</span>
      </h2>

      <a href="/start" class="cta-primary group" data-magnetic>
        <span class="cta-primary-inner">
          <span class="cta-label">Start a Project</span>
          <svg class="cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          </svg>
        </span>
      </a>
    </div>
  </section>

</Base>

<style>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-up {
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-up { animation: none; opacity: 1; }
  }

  .cta-primary {
    position: relative;
    display: inline-flex;
    isolation: isolate;
    border: 1px solid rgba(37, 99, 235, 0.6);
    background: linear-gradient(180deg, #2D72FF 0%, #2563EB 45%, #1E40AF 100%);
    box-shadow:
      0 0 0 1px rgba(37, 99, 235, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.20),
      inset 0 -1px 0 rgba(0, 0, 0, 0.25),
      0 0 24px rgba(37, 99, 235, 0.45),
      0 0 60px rgba(37, 99, 235, 0.25);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-primary-inner {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 2rem;
    color: #FAF8F3;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .cta-primary .cta-arrow {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-primary:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(37, 99, 235, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 0 36px rgba(37, 99, 235, 0.7),
      0 0 100px rgba(37, 99, 235, 0.4);
  }
  .cta-primary:hover .cta-arrow {
    transform: translateX(3px);
  }
</style>
