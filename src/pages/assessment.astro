---
import Base from '../layouts/Base.astro';
import AssessmentForm from '../components/assessment/AssessmentForm';

const TITLE = 'Free Project Assessment — BLVSTACK';
const DESC = 'Six quick questions about the site you want. Get a short brief back: what you’re after, how we’d approach it, and a rough timeline. Free, no commitment.';
---

<Base title={TITLE} description={DESC} noIndex={false} ogImage="/og/assessment.png">

  <!-- ════════════════ HERO ════════════════ -->
  <section class="relative pt-40 md:pt-48 pb-16 px-6 md:px-12 lg:px-16 max-w-5xl mx-auto">

    <div class="flex items-center gap-4 mb-10 opacity-0 animate-fade-up" style="animation-delay: 0.1s;">
      <span class="h-px w-10 bg-electric"></span>
      <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-electric">
        // Free Project Assessment
      </span>
      <span class="font-mono text-[11px] tracking-widest uppercase text-slate/70">
        About 2 minutes
      </span>
    </div>

    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-cream leading-[0.95] max-w-4xl opacity-0 animate-fade-up" style="animation-delay: 0.25s;">
      Get a clear plan<br />
      <span class="text-electric">for your site.</span>
    </h1>

    <p class="mt-12 text-base md:text-lg text-slate leading-relaxed max-w-xl opacity-0 animate-fade-up" style="animation-delay: 0.4s;">
      Six quick questions. You’ll get a short brief back — what you’re after, how we’d approach it, and a rough timeline. Free, no commitment.
    </p>
  </section>

  <!-- ════════════════ FORM ════════════════ -->
  <section class="px-6 md:px-12 lg:px-16 pb-20 max-w-5xl mx-auto">
    <div class="border-t border-white/5 pt-16">
      <AssessmentForm client:load />
    </div>
  </section>

</Base>

<style>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-up {
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-up { animation: none; opacity: 1; }
  }
</style>
