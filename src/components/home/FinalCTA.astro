<!-- Sits on the electric band (the #cta wrapper on the homepage sets the tone). -->
<section class="relative overflow-hidden px-6 md:px-16 py-28">

  <div class="relative max-w-7xl mx-auto flex flex-col items-start gap-16">

    <p class="font-mono text-xs tracking-widest uppercase text-cream">Ready?</p>

    <h2 class="text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-cream leading-[0.9]">
      Let's build your site.
    </h2>

    <div class="flex flex-col gap-6">
      <a
        href="/start"
        data-magnetic
        class="inline-flex items-center justify-center self-start px-10 py-5 rounded-full bg-cream text-navy font-mono text-sm tracking-widest uppercase hover:bg-navy hover:text-cream transition-colors duration-300"
      >
        Start a Project
      </a>
      <a href="/assessment" class="font-mono text-xs tracking-widest uppercase text-cream underline-offset-4 hover:underline">
        Not sure yet? Take the free assessment &rarr;
      </a>
    </div>

  </div>

</section>
