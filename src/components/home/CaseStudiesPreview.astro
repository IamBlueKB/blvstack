---
// Featured work on the homepage — full-attention panels, one per project.
// Both PSRx Body & Skin and T'Aura the Poet are featured (Blue, 2026-09-29): same
// panel design as before, rendered per case; the second mirrors (screenshot right).

type Tag = { label: string; href?: string };
type Case = {
  href: string;
  domain: string;
  screenshot: string;
  screenshotAlt: string;
  /** Logo file (light, for the dark panel); null = set the name as type. */
  logo: string | null;
  logoName: string;
  logoClass: string;
  code: string;
  glyph: 0 | 1 | 2;
  title: string;
  accent: string;
  body: string;
  tags: Tag[];
};

const CASES: Case[] = [
  {
    href: '/work/psrx-body-and-skin',
    domain: 'psrxbodyandskin.com',
    screenshot: '/case-studies/psrx-body-and-skin.png',
    screenshotAlt: 'PSRx Body & Skin — clinical skin intelligence platform',
    logo: '/case-studies/psrx-body-and-skin-logo.png',
    logoName: 'PSRx Body & Skin',
    logoClass: 'h-12 md:h-16',
    code: 'CS2 · Platform',
    glyph: 1,
    title: 'An AI skin platform',
    accent: 'for a clinical practice.',
    body: 'AI assessment, members-only Skin Intelligence Portal, monthly protocols supervised by the clinical team — built for a working aesthetics clinic.',
    tags: [
      { label: 'Skin Assessment', href: 'https://psrxbodyandskin.com/' },
      { label: 'Members Portal', href: 'https://psrxbodyandskin.com/join' },
      { label: 'AI Protocols' },
    ],
  },
  {
    href: '/work/taurathepoet',
    domain: 'taurathepoet.com',
    screenshot: '/case-studies/taurathepoet.jpg',
    screenshotAlt: 'T’Aura the Poet — spoken-word artist site',
    logo: '/case-studies/taurathepoet-logo.svg',
    logoName: 'T’Aura the Poet',
    logoClass: 'h-10 md:h-12',
    code: 'CS3 · Artist',
    glyph: 2,
    title: 'A cinematic home',
    accent: 'for a spoken-word artist.',
    body: 'Her debut album playable in the page, her events and bookings in one place, and her nonprofit on its own page — built to feel like a performance.',
    tags: [
      { label: 'Album Player', href: 'https://taurathepoet.com/#project' },
      { label: 'Events Calendar', href: 'https://taurathepoet.com/#events' },
      { label: 'Booking Inquiries', href: 'https://taurathepoet.com/#booking' },
    ],
  },
];
---

<section class="relative w-full py-16 md:py-20 px-6 md:px-12 lg:px-16 overflow-hidden">

  <!-- Eyebrow row (top-left of section) -->
  <div class="relative z-20 max-w-[1600px] mx-auto">
    <div class="flex items-center gap-4">
      <span class="h-px w-10 bg-electric"></span>
      <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-electric">
        // Recent Work
      </span>
    </div>
  </div>

  {CASES.map((c, i) => {
    const mirror = i % 2 === 1;
    return (
      <div class="flex items-center">
        <div class="relative w-full max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center py-12">

          <!-- Screenshot with glow + tilt + parallax (60%) -->
          <div class={`lg:col-span-7 relative ${mirror ? 'lg:order-2' : ''}`} data-tilt-wrap data-base-y={mirror ? '5' : '-5'}>
            <!-- Electric blue glow halo -->
            <div
              class="pointer-events-none absolute inset-0 -z-10"
              style="
                background:
                  radial-gradient(ellipse 40% 35% at 50% 50%, rgba(96,165,250,0.28) 0%, transparent 70%),
                  radial-gradient(ellipse 70% 55% at 50% 50%, rgba(37,99,235,0.30) 0%, transparent 65%),
                  radial-gradient(ellipse 90% 80% at 40% 60%, rgba(30,64,175,0.20) 0%, transparent 70%);
                filter: blur(40px);
                transform: scale(1.1);
              "
              aria-hidden="true"
            ></div>

            <!-- Frame container — receives tilt + parallax -->
            <div
              data-tilt-target
              class="relative will-change-transform"
              style={`transform: perspective(2400px) rotateY(${mirror ? 5 : -5}deg) rotateX(2deg); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);`}
            >
              <!-- Browser chrome -->
              <div class="flex items-center gap-2 px-4 py-2.5 bg-navy/90 backdrop-blur-sm border border-white/10 border-b-0">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-slate/30"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-slate/30"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-slate/30"></span>
                </div>
                <span class="ml-4 font-mono text-[10px] tracking-wide text-slate/60">{c.domain}</span>
              </div>

              <!-- Screenshot -->
              <div class="relative bg-navy border border-white/10 overflow-hidden aspect-[16/10]">
                <img
                  src={c.screenshot}
                  alt={c.screenshotAlt}
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover object-top"
                />
              </div>
            </div>
          </div>

          <!-- Text panel (40%) -->
          <div class={`lg:col-span-5 flex flex-col gap-8 ${mirror ? 'lg:order-1' : ''}`}>

            <!-- Client logo (or the name set as type when there's no logo file) -->
            {c.logo ? (
              <img src={c.logo} alt={c.logoName} class={`${c.logoClass} w-auto self-start object-contain`} />
            ) : (
              <span class="self-start font-bold text-2xl md:text-3xl text-cream tracking-tight">{c.logoName}</span>
            )}

            <!-- Stack-layer code label -->
            <div class="flex items-center gap-3">
              <span class="inline-flex flex-col gap-[2px] mr-1" aria-hidden="true" style="width: 14px;">
                {[0, 1, 2].map((n) => (
                  <span class={`block h-[1.5px] w-full ${n === c.glyph ? 'bg-electric' : 'bg-slate/40'}`}></span>
                ))}
              </span>
              <span class="font-mono text-[11px] tracking-widest uppercase text-slate">{c.code}</span>
            </div>

            <!-- Editorial headline -->
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-cream leading-[0.95]">
              {c.title}<br />
              <span class="text-electric">{c.accent}</span>
            </h2>

            <!-- Body -->
            <p class="text-base md:text-lg text-slate leading-relaxed max-w-md">{c.body}</p>

            <!-- Capability tags — linked ones open the live deliverable -->
            <div class="flex flex-wrap gap-2">
              {c.tags.map((tag) => (
                tag.href ? (
                  <a
                    href={tag.href}
                    target="_blank"
                    rel="noopener"
                    class="font-mono text-[10px] tracking-widest uppercase text-cream/75 border border-white/10 hover:border-electric/40 hover:text-electric transition-colors duration-300 px-3 py-1.5 inline-flex items-center gap-1.5"
                  >
                    {tag.label}
                    <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true" class="opacity-60">
                      <path d="M2 7L7 2M7 2H3M7 2V6" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" />
                    </svg>
                  </a>
                ) : (
                  <span class="font-mono text-[10px] tracking-widest uppercase text-cream/75 border border-white/10 hover:border-electric/40 hover:text-electric transition-colors duration-300 px-3 py-1.5">
                    {tag.label}
                  </span>
                )
              ))}
            </div>

            <!-- CTA -->
            <a
              href={c.href}
              class="group inline-flex items-center gap-3 self-start font-mono text-xs tracking-[0.25em] uppercase text-cream hover:text-electric transition-colors duration-300 pt-2"
            >
              <span>See the build</span>
              <svg width="22" height="10" viewBox="0 0 22 10" fill="none" class="group-hover:translate-x-1 transition-transform duration-300" aria-hidden="true">
                <path d="M1 5H21M21 5L17 1M21 5L17 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
              </svg>
            </a>
          </div>

        </div>
      </div>
    );
  })}

</section>

<script is:inline>
  // Mouse-follow parallax on each screenshot (per panel; the base angle mirrors).
  (() => {
    document.querySelectorAll('[data-tilt-wrap]').forEach((wrap) => {
      const target = wrap.querySelector('[data-tilt-target]');
      if (!target) return;
      const baseY = Number(wrap.getAttribute('data-base-y') || -5);
      let tx = baseY, ty = 2;
      let targetX = baseY, targetY = 2;
      let raf = 0;
      let running = false;

      const tick = () => {
        tx += (targetX - tx) * 0.08;
        ty += (targetY - ty) * 0.08;
        target.style.transform = `perspective(2400px) rotateY(${tx.toFixed(2)}deg) rotateX(${ty.toFixed(2)}deg)`;
        if (Math.abs(targetX - tx) > 0.01 || Math.abs(targetY - ty) > 0.01) {
          raf = requestAnimationFrame(tick);
        } else {
          running = false;
        }
      };
      const kick = () => { if (!running) { running = true; raf = requestAnimationFrame(tick); } };

      wrap.addEventListener('mousemove', (e) => {
        const r = wrap.getBoundingClientRect();
        const dx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        const dy = ((e.clientY - r.top) / r.height - 0.5) * 2;
        targetX = baseY + dx * 4;
        targetY = 2 - dy * 3;
        kick();
      });
      wrap.addEventListener('mouseleave', () => {
        targetX = baseY;
        targetY = 2;
        kick();
      });
    });
  })();
</script>
