---
import FounderVisual from './FounderVisual';
import Brand from '../Brand.astro';
---

<section class="px-6 md:px-16 py-20 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-16">

    <!-- Left: interactive 3D stack, on a navy panel (the section is cream) -->
    <div class="tone-dark md:col-span-5 flex items-center justify-center min-h-[360px] bg-navy p-4">
      <FounderVisual client:only="react" />
    </div>

    <!-- Right: quote block -->
    <div class="md:col-span-7 flex flex-col justify-center">
      <p class="font-mono text-xs tracking-widest uppercase text-electric mb-10">Founder Note</p>
      <blockquote class="space-y-6">
        <p class="text-2xl md:text-3xl lg:text-[2rem] font-bold text-cream leading-tight tracking-tight">
          "A website shouldn't just sit there. It should look like you and&nbsp;<span class="text-electric">bring the work in.</span>"
        </p>
        <p class="text-base text-slate leading-relaxed max-w-md">
          Every build starts with one question: what should this site do for you after launch? <Brand /> designs the site people remember, then builds in the parts that bring clients in, so you're not the one chasing them.
        </p>
        <footer class="flex items-center gap-4 pt-2">
          <div class="w-8 h-px bg-electric" />
          <cite class="not-italic font-mono text-xs tracking-widest uppercase text-slate">
            — Blue, Founder
          </cite>
        </footer>
      </blockquote>
    </div>

  </div>
</section>
