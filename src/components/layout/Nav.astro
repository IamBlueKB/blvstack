---
import NavOverlay from './NavOverlay';
---

<!-- Top-left logo — fixed on desktop, scrolls away on mobile. Drawn through a mask so
     its color can follow the section under it: blue, or cream over the electric bands. -->
<a
  href="/"
  aria-label="BLVSTACK — Home"
  class="absolute md:fixed top-6 left-6 z-50 block w-32 hover:opacity-70 transition-opacity duration-300"
>
  <span data-nav-logo class="nav-logo block w-full aspect-square" aria-hidden="true"></span>
</a>
<script is:inline>
  (() => {
    const logo = document.querySelector('[data-nav-logo]');
    if (!logo) return;
    let queued = false;
    const update = () => {
      queued = false;
      const r = logo.getBoundingClientRect();
      // .tone-electric = the electric bands; .on-blue = other solid-blue strips (the marquee)
      const onBlue = document.elementsFromPoint(r.left + r.width / 2, r.top + r.height / 2)
        .some((el) => el.closest('.tone-electric, .on-blue'));
      logo.style.setProperty('--nav-logo', onBlue ? '#FAF8F3' : '#0F48DC');
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    // The nav renders before the page content, so wait for it
    if (document.readyState === 'loading') addEventListener('DOMContentLoaded', update);
    else update();
  })();
</script>

<!-- Nav overlay (React island — handles open/close state) -->
<NavOverlay client:load />
